# Frozen prompts are hashed byte for byte (manifest sha256): never convert their line endings.
bench/prompts/** -text

# launchers keep their platform line endings wherever the repository is cloned
*.sh text eol=lf
*.bat text eol=crlf

# copies of real packs' native_experts.txt, parsed byte for byte by tests/core/expert_layout_test.cpp
tests/data/native_experts/** -text

# Hashed kernel snapshots retain upstream bytes, including existing whitespace.
bench/results/2026-10-05-sycl-prefill-scaling/dequant-workgroup-probe/source/** -text -whitespace
bench/results/2026-10-11-xe-host-sanitizer-qualification/*.patch -text -whitespace
