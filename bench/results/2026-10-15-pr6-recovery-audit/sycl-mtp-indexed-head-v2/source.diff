+void validate_registered_device_span(const void* pointer,size_t bytes) {
+  require(pointer && bytes,"empty registered device span");
+  const uintptr_t address=reinterpret_cast<uintptr_t>(pointer);
+  std::lock_guard lock(registry_mutex);
+  for(const auto& entry:allocations) {
+    const uintptr_t base=reinterpret_cast<uintptr_t>(entry.first);
+    const auto& memory=entry.second;
+    if(address>=base && address-base<=memory.allocation->size() &&
+       bytes<=memory.allocation->size()-(address-base)) {
+      require(memory.kind==MemoryKind::Device,"indexed head requires device allocation");
+      return;
+    }
+  }
+  throw std::invalid_argument("indexed head span exceeds registered device allocation");
+}
