+namespace {
+using strata::prefill::OneDnnFaithfulBf16;
+using namespace strata::sycl_backend;
+constexpr size_t fence=32;
+constexpr uint16_t mark=0xa55a;
+void require(bool b,const char* why) { if(!b) throw std::runtime_error(why); }
+// Decode directly to NORMAL double arithmetic, including BF16 subnormals.
+// A float->double hardware conversion could obey host DAZ and hide GPU FTZ.
+double exact16(uint16_t b) {
+  const unsigned e=(b>>7)&255U,m=b&127U;
+  double v;
+  if(e==255) v=m ? std::numeric_limits<double>::quiet_NaN() :
+                          std::numeric_limits<double>::infinity();
+  else if(!e) v=std::ldexp(double(m),-133);
+  else v=std::ldexp(double(128+m),int(e)-134);
+  return b&0x8000U ? -v : v;
+}
+uint16_t rne(float f) {
+  uint32_t b=std::bit_cast<uint32_t>(f);
+  if((b&0x7fffffffU)>0x7f800000U) return uint16_t((b>>16)|0x40U);
+  return uint16_t((b+0x7fffU+((b>>16)&1U))>>16);
+}
+bool nan16(uint16_t b) { return (b&0x7fffU)>0x7f80U; }
+// Monotonic BF16 rank; negative and positive zero are adjacent ranks. No
+// numerical tolerance is used for specials, zeros or representable subnormals.
+int rank16(uint16_t b) { return b&0x8000U ? int(uint16_t(~b)) : int(b|0x8000U); }
+uint16_t unrank16(int r) {
+  return r&0x8000 ? uint16_t(r&0x7fff) : uint16_t(~uint16_t(r));
+}
+uint16_t nearest16(double exact) {
+  const double a=std::abs(exact);
+  require(a<=exact16(0x7f7f),"finite oracle outside this fixture's BF16 range");
+  // Independent integer search over BF16 encodings. No float cast means host
+  // FTZ/DAZ cannot turn an expected BF16 subnormal into an accepted zero.
+  unsigned lo=0,hi=0x7f7f;
+  while(lo<hi) {
+    const unsigned mid=(lo+hi+1)/2;
+    if(exact16(uint16_t(mid))<=a) lo=mid; else hi=mid-1;
+  }
+  unsigned best=lo;
+  if(exact16(uint16_t(lo))!=a) {
+    const double down=a-exact16(uint16_t(lo));
+    const double up=exact16(uint16_t(lo+1))-a;
+    if(up<down || (up==down && (lo&1U))) best=lo+1;
+  }
+  return uint16_t(best | (std::signbit(exact) ? 0x8000U : 0));
+}
+void faithful(uint16_t got,double exact) {
+  if(std::isnan(exact)) {
+    require(nan16(got) && (got&0x40U),"NaN must remain a quiet NaN (payload unspecified)");
+    return;
+  }
+  const double max_fp32=std::ldexp(2.-std::ldexp(1.,-23),127);
+  const double overflow_midpoint=std::ldexp(2.-std::ldexp(1.,-24),127);
+  if(std::isinf(exact) || std::abs(exact)>=overflow_midpoint) {
+    const uint16_t infinity=std::signbit(exact) ? 0xff80 : 0x7f80;
+    require(got==infinity,"signed infinity/finite overflow mismatch");
+    return;
+  }
+  require(std::abs(exact)<=max_fp32,"fixture contains an unmodelled borderline FP32 overflow sum");
+  const uint16_t nearest=nearest16(exact);
+  require(std::isfinite(exact16(got)),"unexpected NaN/Inf (possibly destination NaN read)");
+  // Exactly representable outputs get ZERO slack. This rejects FTZ even for
+  // the smallest BF16 subnormal, where a one-rank test alone would accept 0.
+  if(exact16(nearest)==exact) {
+    require(got==nearest,"exact BF16 value/zero/subnormal changed");
+    return;
+  }
+  const double a=std::abs(exact);
+  const double spacing=std::ldexp(1.,std::max(-149,std::ilogb(a)-23));
+  require(std::trunc(a/spacing)==a/spacing,
+          "fixture must not conflate FP32 summation with conversion error");
+  const int r=rank16(nearest);
+  const int other=r+(exact16(nearest)<exact ? 1 : -1);
+  const uint16_t neighbor=unrank16(other);
+  require(std::isfinite(exact16(neighbor)),"finite fixture unexpectedly at overflow boundary");
+  require(got==nearest || got==neighbor,"not one of the two BF16 values bracketing oracle");
+  require(std::abs(rank16(got)-rank16(nearest))<=1,"more than one BF16 step from RNE oracle");
+}
+struct Buffer {
+  Allocation allocation;
+  size_t words;
+  Buffer(std::shared_ptr<Runtime> rt,size_t n)
+      : allocation(rt,2*(n+2*fence),MemoryKind::Device),words(n) {}
+  uint16_t* base() const { return allocation.as<uint16_t>(); }
+  uint16_t* data() const { return base()+fence; }
+  std::vector<uint16_t> image(uint16_t fill=mark) const {
+    return std::vector<uint16_t>(words+2*fence,fill);
+  }
+};
+void upload(sycl::queue& q,const Buffer& b,const std::vector<uint16_t>& a) {
+  require(a.size()==b.words+2*fence,"fixture upload size");
+  q.memcpy(b.base(),a.data(),2*a.size()).wait_and_throw();
+}
+std::vector<uint16_t> download(sycl::queue& q,const Buffer& b) {
+  auto a=b.image(); q.memcpy(a.data(),b.base(),2*a.size()).wait_and_throw(); return a;
+}
+void identity(const OneDnnFaithfulBf16::Plan& p) {
+  require(p.gpu_engine && p.same_queue_context_device && p.strict_accumulation &&
+      p.strict_fpmath && p.user_scratchpad && p.environment_rounding &&
+      p.exact_bf16_descriptors,"actual descriptor/engine/attribute mismatch");
+  std::cout << "shape="<<p.t<<','<<p.n<<','<<p.k<<','<<p.ldy
+    <<" implementation="<<p.implementation<<"\ndevice="<<p.device
+    <<"\ndriver="<<p.driver<<"\nlibrary_hash="<<p.library_hash
+    <<"\nqueue_backend="<<p.queue_backend<<" library_cache_capacity="<<p.library_cache_capacity
+    <<"\nstrict_accumulation="<<p.strict_accumulation<<" strict_fpmath="<<p.strict_fpmath
+    <<" user_scratchpad="<<p.user_scratchpad<<" environment_rounding="<<p.environment_rounding
+    <<" exact_bf16_descriptors="<<p.exact_bf16_descriptors
+    <<"\nscratchpad_bytes="<<p.scratchpad_bytes
+    <<" primitive_owned_memory_bytes="<<p.primitive_owned_memory_bytes
+    <<" full_fp32_output_equivalent_bytes="<<p.full_fp32_output_equivalent_bytes
+    <<"\ninternal_fp32_partition=UNKNOWN native_XMX=UNESTABLISHED GPU_arithmetic=UNQUALIFIED\n";
+}
+void bounds(const OneDnnFaithfulBf16::Stats& s) {
+  require(s.cached_shapes<=OneDnnFaithfulBf16::max_cached_shapes,"cache >32");
+  require(s.pending_arguments<=OneDnnFaithfulBf16::max_pending_arguments,"pending owners >512");
+  require(s.scratch_allocated_bytes+s.primitive_owned_memory_bytes<=
+      OneDnnFaithfulBf16::max_temporary_bytes,"object temporaries >128 MiB");
+}
+enum class Pattern { finite, midpoint, cancellation, identity_subnormal,
+                     underflow_halfway, quiet_nan, positive_inf, negative_inf,
+                     opposite_inf, positive_overflow, negative_overflow, positive_zero };
+void numeric(std::shared_ptr<Runtime> rt,OneDnnFaithfulBf16& g,
+             int t,int n,int k,int ld,Pattern pattern,float beta=0) {
+  auto& q=rt->compute();
+  Buffer x(rt,size_t(t)*k),w(rt,size_t(n)*k),y(rt,size_t(t)*ld);
+  auto a=x.image(),b=w.image(),before=y.image();
+  // Small dyadic products, bounded sums: all finite dots in this fixture are
+  // exactly representable in FP32, independent of accumulation association.
+  for(size_t i=0;i<x.words;++i) a[fence+i]=rne(float(int(i*7%23)-11)/16);
+  for(size_t i=0;i<w.words;++i) b[fence+i]=rne(float(int(i*13%19)-9)/32);
+  if(pattern==Pattern::midpoint) {
+    std::fill(a.begin()+fence,a.end()-fence,0);
+    std::fill(b.begin()+fence,b.end()-fence,0);
+    for(int r=0;r<t;++r) for(int j=0;j<3;++j) a[fence+r*k+j]=rne(1);
+    for(int c=0;c<n;++c) {
+      const float sign=c&4 ? -1.f : 1.f;
+      b[fence+c*k]=rne(sign);
+      b[fence+c*k+1]=rne(sign*(c&1 ? 3.f : 1.f)/256);
+      b[fence+c*k+2]=rne(sign*(c%3==0 ? -1.f : c%3==1 ? 0.f : 1.f)/65536);
+    }
+  } else if(pattern==Pattern::cancellation) {
+    require(k==48,"cancellation fixture geometry");
+    std::fill(a.begin()+fence,a.end()-fence,rne(1));
+    for(int c=0;c<n;++c) for(int j=0;j<k;++j)
+      b[fence+c*k+j]=rne(j<16 ? 2048.f : j<32 ? 1.f : -2048.f);
+  } else if(pattern==Pattern::identity_subnormal || pattern==Pattern::underflow_halfway) {
+    const std::array<uint16_t,16> values{0,1,0x8001,0x7f,0x807f,0x80,0x8080,2,
+        0x8002,0x3f80,0xbf80,0x7f7f,0xff7f,0x3f81,0x3f7f,0x8000};
+    for(size_t i=0;i<x.words;++i) a[fence+i]=values[i%values.size()];
+    std::fill(b.begin()+fence,b.end()-fence,0);
+    for(int c=0;c<n;++c)
+      b[fence+c*k+c%k]=rne(pattern==Pattern::underflow_halfway ? .5f : 1.f);
+  } else if(pattern!=Pattern::finite) {
+    const uint16_t value=pattern==Pattern::quiet_nan ? 0x7fc1 :
+        pattern==Pattern::positive_inf || pattern==Pattern::opposite_inf ? 0x7f80 :
+        pattern==Pattern::negative_inf ? 0xff80 :
+        pattern==Pattern::negative_overflow ? 0xff7f :
+        pattern==Pattern::positive_zero ? 0 : 0x7f7f;
+    std::fill(a.begin()+fence,a.end()-fence,value);
+    std::fill(b.begin()+fence,b.end()-fence,rne(2));
+    if(pattern==Pattern::opposite_inf)
+      for(int r=0;r<t;++r) a[fence+r*k+1]=0xff80;
+  }
+  // beta=0 must never read these old destination quiet NaNs.
+  for(int r=0;r<t;++r) for(int c=0;c<n;++c) before[fence+r*ld+c]=0x7fc1;
+  upload(q,x,a); upload(q,w,b); upload(q,y,before);
+  identity(g.prepare(t,n,k,ld));
+  const auto event=g.submit(x.data(),w.data(),y.data(),t,n,k,ld,beta);
+  event.wait_and_throw();
+  g.wait(); rt->check(); bounds(g.stats());
+  auto out=download(q,y);
+  for(size_t i=0;i<out.size();++i) {
+    const bool live=i>=fence && i<fence+y.words && (i-fence)%size_t(ld)<size_t(n);
+    if(!live) { require(out[i]==before[i],"guard/row-stride/tail overwrite"); continue; }
+    const size_t r=(i-fence)/ld,c=(i-fence)%ld;
+    double exact=0;
+    for(int j=0;j<k;++j) exact+=exact16(a[fence+r*k+j])*exact16(b[fence+c*k+j]);
+    faithful(out[i],exact);
+  }
+  require(download(q,x)==a && download(q,w)==b,"input or weight/guard modified");
+}
+template<class F> void invalid(F f) {
+  try { f(); } catch(const std::invalid_argument&) { return; }
+  throw std::runtime_error("expected invalid_argument before primitive preparation");
+}
+template<class F> void closed(F f) {
+  try { f(); } catch(const std::logic_error&) { return; }
+  throw std::runtime_error("closed object accepted operation");
+}
+void negatives(std::shared_ptr<Runtime> rt) {
+  auto& q=rt->compute();
+  OneDnnFaithfulBf16 g(rt,q);
+  Buffer x(rt,2048),w(rt,2048),y(rt,2048);
+  auto a=x.image(),b=w.image(),c=y.image();
+  upload(q,x,a); upload(q,w,b); upload(q,y,c);
+  auto call=[&](const uint16_t* xp,const uint16_t* wp,uint16_t* yp,
+      int64_t t=3,int64_t n=16,int64_t k=16,int64_t ld=19,float beta=0) {
+    (void)g.submit(xp,wp,yp,t,n,k,ld,beta);
+  };
+  for(auto t : {int64_t(0),int64_t(-1),INT64_MAX}) invalid([&]{call(x.data(),w.data(),y.data(),t);});
+  for(auto n : {int64_t(0),int64_t(-1),INT64_MAX}) invalid([&]{call(x.data(),w.data(),y.data(),3,n);});
+  for(auto k : {int64_t(0),int64_t(-1),INT64_MAX}) invalid([&]{call(x.data(),w.data(),y.data(),3,16,k);});
+  for(auto ld : {int64_t(-1),int64_t(15),INT64_MAX}) invalid([&]{call(x.data(),w.data(),y.data(),3,16,16,ld);});
+  for(float beta : {1.f,.5f,-.25f,std::numeric_limits<float>::infinity(),
+      -std::numeric_limits<float>::infinity(),std::numeric_limits<float>::quiet_NaN()})
+    invalid([&]{call(x.data(),w.data(),y.data(),3,16,16,19,beta);});
+  invalid([&]{call(nullptr,w.data(),y.data());});
+  invalid([&]{call(x.data(),nullptr,y.data());});
+  invalid([&]{call(x.data(),w.data(),nullptr);});
+  invalid([&]{call(x.data(),w.data(),x.data());});
+  invalid([&]{call(x.data(),w.data(),w.data()+1);});
+  auto* misaligned=reinterpret_cast<uint16_t*>(reinterpret_cast<uintptr_t>(x.data())+1);
+  invalid([&]{call(misaligned,w.data(),y.data());});
+  invalid([&]{call(x.data(),misaligned,y.data());});
+  invalid([&]{call(x.data(),w.data(),misaligned);});
+  Allocation tiny(rt,16,MemoryKind::Device),host(rt,4096,MemoryKind::Host);
+  invalid([&]{call(tiny.as<uint16_t>(),w.data(),y.data());});
+  invalid([&]{call(x.data(),tiny.as<uint16_t>(),y.data());});
+  invalid([&]{call(x.data(),w.data(),tiny.as<uint16_t>());});
+  invalid([&]{call(host.as<uint16_t>(),w.data(),y.data());});
+  invalid([&]{call(a.data(),w.data(),y.data());});
+  auto* foreign=sycl::malloc_device<uint16_t>(2048,q);
+  require(foreign!=nullptr,"foreign fixture allocation");
+  try { invalid([&]{call(foreign,w.data(),y.data());}); }
+  catch(...) { sycl::free(foreign,q); throw; }
+  sycl::free(foreign,q);
+  // Genuine context mismatch and queue-order mismatch, before library init.
+  sycl::context other_context(rt->device());
+  sycl::queue other(other_context,rt->device(),sycl::property::queue::in_order{});
+  invalid([&]{OneDnnFaithfulBf16 bad(rt,other);});
+  sycl::queue unordered(rt->context(),rt->device());
+  invalid([&]{OneDnnFaithfulBf16 bad(rt,unordered);});
+  invalid([&]{OneDnnFaithfulBf16 bad(nullptr,q);});
+  invalid([&]{OneDnnFaithfulBf16 bad(rt,q,OneDnnFaithfulBf16::max_temporary_bytes+1);});
+  require(g.stats().executes==0 && g.stats().cache_misses==0,"negative call reached oneDNN preparation");
+  require(download(q,x)==a && download(q,w)==b && download(q,y)==c,"negative call changed memory");
+  g.close(); g.close();
+  closed([&]{g.prepare(1,16,16);});
+  closed([&]{call(x.data(),w.data(),y.data());});
+  std::cout<<"negative_contract=PASS\n";
+}
+void numerics(std::shared_ptr<Runtime> rt,bool smoke) {
+  require(std::fegetround()==FE_TONEAREST,"host oracle requires FE_TONEAREST");
+  OneDnnFaithfulBf16 g(rt,rt->compute());
+  size_t cases=0;
+  numeric(rt,g,1,16,16,19,Pattern::finite); ++cases;
+  if(!smoke) {
+    for(auto d : {std::array<int,3>{3,32,32},{17,48,48},{5,7,13},{33,64,129}})
+      for(float beta : {0.f,-0.f}) {
+        numeric(rt,g,d[0],d[1],d[2],d[1]+3,Pattern::finite,beta); ++cases;
+      }
+    numeric(rt,g,3,16,16,19,Pattern::midpoint); ++cases;
+    numeric(rt,g,3,16,48,16,Pattern::cancellation); ++cases;
+    for(auto p : {Pattern::identity_subnormal,Pattern::underflow_halfway,Pattern::quiet_nan,
+        Pattern::positive_inf,Pattern::negative_inf,Pattern::opposite_inf,
+        Pattern::positive_overflow,Pattern::negative_overflow,Pattern::positive_zero}) {
+      numeric(rt,g,3,16,16,19,p); ++cases;
+    }
+  }
+  g.close();
+  require(g.stats().executes==cases && g.stats().closed,"numerical execute/close counts");
+  std::cout<<"numerical_cases="<<cases<<" faithful_BF16=PASS model_quality=UNESTABLISHED\n";
+}
+void lifecycle(std::shared_ptr<Runtime> rt) {
+  auto& q=rt->compute();
+  Buffer x(rt,40*16),w(rt,16*16),y(rt,40*19);
+  auto a=x.image(),b=w.image(),before=y.image();
+  std::fill(a.begin()+fence,a.end()-fence,rne(1));
+  std::fill(b.begin()+fence,b.end()-fence,rne(1));
+  upload(q,x,a); upload(q,w,b); upload(q,y,before);
+  // Drop the caller's ORIGINAL queue wrapper before using the comparison.
+  std::unique_ptr<OneDnnFaithfulBf16> g;
+  { auto local=rt->make_queue(); g=std::make_unique<OneDnnFaithfulBf16>(rt,local); }
+  for(int t=1;t<=40;++t) {
+    (void)g->submit(x.data(),w.data(),y.data(),t,16,16,19);
+    bounds(g->stats());
+  }
+  const auto s=g->stats();
+  identity(g->prepare(40,16,16,19));
+  require(g->stats().cache_hits==s.cache_hits+1,"shape cache miss");
+  (void)g->prepare(40,16,16,20);
+  require(g->stats().cache_misses==s.cache_misses+1,"stride cache key alias");
+  for(size_t i=0;i<1025;++i) {
+    (void)g->submit(x.data(),w.data(),y.data(),40,16,16,19);
+    bounds(g->stats());
+  }
+  auto independent_queue=rt->make_queue();
+  OneDnnFaithfulBf16 independent(rt,independent_queue);
+  (void)independent.prepare(40,16,16,19);
+  require(independent.stats().cache_misses==1 && independent.stats().executes==0,"cross-object cache contamination");
+  independent.close();
+  const auto queued=g->stats();
+  g->close(); g->close();
+  auto done=g->stats();
+  require(done.closed && done.cached_shapes==0 && done.pending_arguments==0 &&
+      done.scratch_allocated_bytes==0 && done.primitive_owned_memory_bytes==0,"close retained live resources");
+  closed([&]{g->prepare(1,16,16);});
+  auto out=download(q,y);
+  for(size_t i=0;i<out.size();++i) {
+    const bool live=i>=fence && i<fence+y.words && (i-fence)%19<16;
+    require(out[i]==(live ? rne(16) : before[i]),"close result/guard mismatch");
+  }
+  // Destructor, with actual queued work and no explicit wait/close.
+  upload(q,y,before);
+  { OneDnnFaithfulBf16 automatic(rt,q); (void)automatic.submit(x.data(),w.data(),y.data(),40,16,16,19); }
+  require(download(q,y)==out,"destructor did not complete queued output");
+  require(download(q,x)==a && download(q,w)==b,"lifecycle input/weight overwrite");
+  std::cout<<"cache_queue_close_destructor=PASS executes="<<done.executes
+      <<" pending_before_close="<<queued.pending_arguments
+      <<" capacity_drains="<<done.capacity_drains<<" peak_scratch_bytes="<<done.peak_scratch_bytes
+      <<" fault_injection=UNRUN\n";
+}
+void chain(std::shared_ptr<Runtime> rt) {
+  auto& q=rt->compute();
+  Buffer x(rt,3*16),w(rt,16*16),y(rt,3*16),z(rt,3*16);
+  auto a=x.image(),b=w.image(),before=y.image();
+  for(size_t i=0;i<x.words;++i) a[fence+i]=rne(float(int(i%17)-8)/16);
+  std::fill(b.begin()+fence,b.end()-fence,0);
+  for(size_t c=0;c<16;++c) b[fence+c*16+c]=rne(2);
+  std::fill(before.begin()+fence,before.end()-fence,0x7fc1);
+  upload(q,x,a); upload(q,w,b); upload(q,y,before); upload(q,z,before);
+  OneDnnFaithfulBf16 g(rt,q);
+  identity(g.prepare(3,16,16));
+  (void)g.submit(x.data(),w.data(),y.data(),3,16,16);
+  // Producer destination is the next consumer source in the SAME BF16 device
+  // allocation. No whole-hidden FP32 restoration, host conversion or transfer.
+  (void)g.submit(y.data(),w.data(),z.data(),3,16,16);
+  g.close();
+  auto middle=download(q,y),last=download(q,z);
+  for(size_t i=0;i<last.size();++i) {
+    const bool live=i>=fence && i<fence+x.words;
+    if(live) {
+      faithful(middle[i],exact16(a[i])*2);
+      faithful(last[i],exact16(a[i])*4);
+    } else require(middle[i]==before[i] && last[i]==before[i],"BF16 chain guard overwrite");
+  }
+  require(download(q,x)==a && download(q,w)==b,"BF16 chain changed input/weight");
+  require(g.stats().executes==2,"BF16 chain execute count");
+  std::cout<<"BF16_producer_consumer_chain=PASS internal_FP32_storage=UNKNOWN\n";
+}
+void scratch_budget(std::shared_ptr<Runtime> rt) {
+  OneDnnFaithfulBf16 normal(rt,rt->compute());
+  const auto p=normal.prepare(17,48,48,51); identity(p); normal.close();
+  OneDnnFaithfulBf16 zero(rt,rt->compute(),0);
+  if(p.scratchpad_bytes || p.primitive_owned_memory_bytes) {
+    bool rejected=false;
+    try { (void)zero.prepare(17,48,48,51); }
+    catch(const strata::prefill::OneDnnBf16TemporaryLimit&) { rejected=true; }
+    require(rejected && zero.stats().executes==0,"nonzero actual scratch accepted zero budget");
+    std::cout<<"actual_nonzero_scratch_zero_budget_reject=PASS\n";
+  } else {
+    (void)zero.prepare(17,48,48,51);
+    std::cout<<"actual_nonzero_scratch_zero_budget_reject=NOT_EXERCISED actual_scratch_bytes=0\n";
+  }
+  zero.close();
+}
+} // namespace
+
+int main(int argc,char** argv) {
+  try {
+    require(argc==2,"usage: sycl_onednn_faithful_bf16_test --smoke|--inspect|--negative|--numerics|--lifecycle|--scratch|--chain");
+    const std::string mode=argv[1];
+    require(mode=="--smoke" || mode=="--inspect" || mode=="--negative" ||
+        mode=="--numerics" || mode=="--lifecycle" || mode=="--scratch" || mode=="--chain","unknown mode");
+    // Main freezes each child's environment before exec; NO setenv/unsetenv.
+    auto rt=runtime_for();
+    if(mode=="--negative") negatives(rt);
+    else if(mode=="--lifecycle") lifecycle(rt);
+    else if(mode=="--scratch") scratch_budget(rt);
+    else if(mode=="--chain") chain(rt);
+    else if(mode=="--inspect") {
+      OneDnnFaithfulBf16 g(rt,rt->compute()); identity(g.prepare(17,48,48,51)); g.close();
+      std::cout<<"inspection=PASS execution=UNRUN\n";
+    } else numerics(rt,mode=="--smoke");
+    rt->check();
+    return 0;
+  } catch(const std::exception& e) {
+    std::cerr<<"status=FAIL reason="<<e.what()<<'\n'; return 1;
+  }
+}
