+// Independently authored for Strata R804; repository LICENSE (MIT) applies.
+// SOURCE PROPOSAL: never compiled, loaded or run by the dispatched implementer.
+#include "strata/prefill/onednn_faithful_bf16.hpp"
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cfenv>
