+// Independently authored for Strata R804; repository LICENSE (MIT) applies.
+#pragma once
+
+#include "strata/sycl/runtime.hpp"
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <stdexcept>
+#include <string>
+
+namespace strata::prefill {
+
+class OneDnnBf16TemporaryLimit : public std::runtime_error {
+public:
+  using std::runtime_error::runtime_error;
+};
+
+// Optional component comparison API. This is NOT Gemm::bf16_out16's exact-RNE
+// contract. BF16 inputs/weights/destination; strict FP32 accumulation; oneDNN's
+// faithful destination conversion. See README for the separate numerical gate.
+// Host calls, including destruction, must be serialized per object. Other
+// objects/queues must not concurrently access this object's writable buffers.
+class OneDnnFaithfulBf16 {
+public:
+  static constexpr size_t max_cached_shapes = 32;
+  static constexpr size_t max_pending_arguments = 512;
+  static constexpr size_t max_temporary_bytes = 128 * size_t(1024) * 1024;
+
+  struct Plan {
+    std::string implementation, device, driver, library_hash;
+    int queue_backend = -1;
+    int library_cache_capacity = -1;
+    int64_t t = 0, n = 0, k = 0, ldy = 0;
+    size_t scratchpad_bytes = 0;
+    size_t primitive_owned_memory_bytes = 0; // public descriptor query
+    size_t full_fp32_output_equivalent_bytes = 0; // comparison scale, NOT usage
+    bool gpu_engine = false, same_queue_context_device = false;
+    bool strict_accumulation = false, strict_fpmath = false;
+    bool user_scratchpad = false, environment_rounding = false;
+    bool exact_bf16_descriptors = false;
+    // The public API does not expose scratch sub-buffer types or selected ISA.
+    // No assertion of native XMX, zero internal FP32, or CPU-time attribution.
+  };
+  struct Stats {
+    uint64_t cache_hits = 0, cache_misses = 0, executes = 0;
+    uint64_t completion_drains = 0, capacity_drains = 0;
+    size_t cached_shapes = 0, pending_arguments = 0;
+    size_t scratch_allocated_bytes = 0, peak_scratch_bytes = 0;
+    size_t primitive_owned_memory_bytes = 0;
+    bool closed = false, poisoned = false;
+  };
+
+  // Retains BOTH the Runtime (registry/allocation domain and sticky errors)
+  // and a copy of the actual caller queue. Never creates/selects a new queue.
+  // The queue must be an in-order Intel GPU queue in this Runtime's domain.
+  // Initialization of the explicit oneDNN GPU engine is lazy, in prepare or
+  // submit. Its actual backend support is checked by the real public API.
+  OneDnnFaithfulBf16(std::shared_ptr<sycl_backend::Runtime> runtime,
+                    const sycl::queue& queue,
+                    size_t temporary_limit_bytes = max_temporary_bytes);
+  ~OneDnnFaithfulBf16() noexcept;
+  OneDnnFaithfulBf16(const OneDnnFaithfulBf16&) = delete;
+  OneDnnFaithfulBf16& operator=(const OneDnnFaithfulBf16&) = delete;
+
+  // Descriptor/primitive preparation may JIT code, but does not enqueue GEMM.
+  // Reports actual selection; unsupported engine/geometry/attributes/scratch
+  // budget throw, without a CPU fallback or an alternative queue/backend.
+  Plan prepare(int64_t t, int64_t n, int64_t k, int64_t ldy = 0);
+
+  // Y[t,n] = X[t,k] * transpose(W[n,k]); X/W contiguous; Y stride ldy.
+  // ldy=0 means n. Y must cover the conservative full t*ldy rectangle.
+  // All pointers must be registered Strata device allocations in this domain,
+  // 2-byte aligned, with non-overlapping output/input extents. X and W may alias.
+  // Only +/-0 beta is supported; destination contents are not an input.
+  // Returns the actual oneDNN completion event; retains primitive, all memory
+  // wrappers, engine, stream and shared scratch through queued completion.
+  // Caller retains X/W/Y allocations until completion (or checked wait/close).
+  sycl::event submit(const uint16_t* x, const uint16_t* w, uint16_t* y,
+                     int64_t t, int64_t n, int64_t k, int64_t ldy = 0,
+                     float beta = 0.f);
+
+  // Completion plus sticky Runtime/asynchronous error check. Keeps the object
+  // open; a runtime error poisons further prepare/submit. No runtime retry.
+  void wait();
+  // Idempotent checked completion then release. If completion is established
+  // but a sticky async error is reported, closes/releases safely and rethrows.
+  // If completion cannot be established, retains owners and throws. Destructor
+  // retries close and fail-stops on error before unsafe member destruction.
+  void close();
+  Stats stats() const;
+
+private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+};
+} // namespace strata::prefill
