+# Independently authored for Strata R804; repository LICENSE (MIT) applies.
+# Optional standalone comparison ONLY. Main may include this after the actual
+# strata_sycl_runtime target exists. No production Gemm or prefill target changes.
+option(STRATA_SYCL_ONEDNN_FAITHFUL_BF16 "Build optional oneDNN BF16 comparison component" OFF)
+if(NOT STRATA_SYCL_ONEDNN_FAITHFUL_BF16)
+  return()
+endif()
+if(NOT STRATA_ENABLE_SYCL OR NOT TARGET strata_sycl_runtime)
+  message(FATAL_ERROR "oneDNN BF16 comparison requires configured Strata SYCL runtime")
+endif()
+set(STRATA_ONEDNN_ROOT "" CACHE PATH "Existing oneDNN 3.11.4 SYCL GPU installation")
+if(NOT STRATA_ONEDNN_ROOT)
+  message(FATAL_ERROR "Set STRATA_ONEDNN_ROOT to the existing inspected installation")
+endif()
+# Resolve only one explicit pre-existing installation, without package discovery
+# that might change backend/runtime dependencies or auto-install a replacement.
+find_path(STRATA_ONEDNN_FAITHFUL_INCLUDE oneapi/dnnl/dnnl_sycl.hpp
+  PATHS "${STRATA_ONEDNN_ROOT}/include" NO_DEFAULT_PATH REQUIRED)
+find_library(STRATA_ONEDNN_FAITHFUL_LIBRARY NAMES dnnl
+  PATHS "${STRATA_ONEDNN_ROOT}/lib" "${STRATA_ONEDNN_ROOT}/lib64" NO_DEFAULT_PATH REQUIRED)
+add_library(strata_onednn_faithful_bf16 STATIC src/prefill/sycl/onednn_faithful_bf16.cpp)
+target_include_directories(strata_onednn_faithful_bf16 PUBLIC "${PROJECT_SOURCE_DIR}/include"
+  PRIVATE "${STRATA_ONEDNN_FAITHFUL_INCLUDE}")
+target_compile_features(strata_onednn_faithful_bf16 PUBLIC cxx_std_20)
+target_compile_options(strata_onednn_faithful_bf16 PRIVATE -fsycl -fno-fast-math -ffp-contract=off)
+target_link_options(strata_onednn_faithful_bf16 INTERFACE -fsycl)
+target_link_libraries(strata_onednn_faithful_bf16 PUBLIC strata_sycl_runtime
+  PRIVATE "${STRATA_ONEDNN_FAITHFUL_LIBRARY}")
+add_executable(sycl_onednn_faithful_bf16_test EXCLUDE_FROM_ALL tests/sycl/onednn_faithful_bf16.cpp)
+target_link_libraries(sycl_onednn_faithful_bf16_test PRIVATE strata_onednn_faithful_bf16)
+target_compile_options(sycl_onednn_faithful_bf16_test PRIVATE -fno-fast-math -ffp-contract=off)
+message(STATUS "R804 standalone comparison include: ${STRATA_ONEDNN_FAITHFUL_INCLUDE}")
+message(STATUS "R804 standalone comparison library: ${STRATA_ONEDNN_FAITHFUL_LIBRARY}")
+# No automatic probe, CTest registration, library load, GPU run, inference hook,
+# global primitive-cache setter or runtime environment mutation.
