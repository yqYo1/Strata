--- /dev/null
+++ b/src/prefill/sycl/onednn_faithful_bf16.cpp
@@ -0,0 +1,366 @@
+// Independently authored for Strata R804; repository LICENSE (MIT) applies.
+// Uses oneDNN's public API; no oneDNN kernel/header implementation is copied.
+#include "strata/prefill/onednn_faithful_bf16.hpp"
+#include "strata/sycl/launch.hpp"
+#include <oneapi/dnnl/dnnl.hpp>
+#include <oneapi/dnnl/dnnl_sycl.hpp>
+#include <oneapi/dnnl/dnnl_version_hash.h>
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <exception>
+#include <limits>
+#include <list>
+#include <optional>
+#include <stdexcept>
+#include <string_view>
+#include <tuple>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#if DNNL_GPU_RUNTIME != DNNL_RUNTIME_SYCL || !defined(DNNL_WITH_SYCL)
+#error "The optional BF16 comparison requires oneDNN SYCL GPU public APIs"
+#endif
+#if DNNL_VERSION_MAJOR != 3 || DNNL_VERSION_MINOR != 11 || DNNL_VERSION_PATCH != 4
+#error "R804 public-API inspection is pinned to oneDNN 3.11.4"
+#endif
+// Deliberately no DNNL_WITH_LEVEL_ZERO gate. Installed generated config leaves
+// it undefined. Actual make_engine/make_stream must accept the supplied domain;
+// the wrapper never manufactures another domain to make initialization succeed.
+
+namespace strata::prefill {
+namespace {
+using namespace sycl_backend;
+using MD = dnnl::memory::desc;
+using DT = dnnl::memory::data_type;
+using Kind = dnnl::sycl_interop::memory_kind;
+
+template<class F> auto api(const char* stage,F&& f) {
+  try { return std::forward<F>(f)(); }
+  catch(const dnnl::error& e) {
+    throw std::runtime_error(std::string("oneDNN ")+stage+" status="+
+        std::to_string(static_cast<int>(e.status))+": "+e.what());
+  }
+}
+
+size_t multiply(size_t a, size_t b) {
+  if (b && a > std::numeric_limits<size_t>::max() / b)
+    throw std::invalid_argument("oneDNN BF16 extent overflow");
+  return a * b;
+}
+struct Shape {
+  int64_t t, n, k, ld;
+  size_t xb, wb, yb, fp32_equivalent;
+  auto key() const { return std::tie(t, n, k, ld); }
+};
+Shape shape(int64_t t, int64_t n, int64_t k, int64_t ld, float beta = 0) {
+  if (!ld) ld = n;
+  if (t <= 0 || n <= 0 || k <= 0 || ld < n ||
+      !std::isfinite(beta) || beta != 0.f)
+    throw std::invalid_argument("invalid oneDNN BF16 geometry/stride/beta (beta must be zero)");
+  return {t, n, k, ld, multiply(checked_count(t,k),2),
+          multiply(checked_count(n,k),2), multiply(checked_count(t,ld),2),
+          multiply(checked_count(t,n),4)};
+}
+sycl::queue checked_queue(const std::shared_ptr<Runtime>& rt, const sycl::queue& q) {
+  if (!rt || !q.has_property<sycl::property::queue::in_order>() ||
+      !q.get_device().is_gpu() ||
+      q.get_device().get_info<sycl::info::device::vendor_id>() != 0x8086 ||
+      q.get_device() != rt->device() || q.get_context() != rt->context())
+    throw std::invalid_argument("oneDNN BF16 requires caller in-order Intel GPU queue in supplied Runtime");
+  rt->check();
+  return q;
+}
+} // namespace
+
+struct OneDnnFaithfulBf16::Impl {
+  // Reverse member destruction also preserves dependency order. close() is the
+  // ordinary release path and must prove completion before releasing anything.
+  std::shared_ptr<Runtime> runtime;
+  sycl::queue q;
+  size_t limit;
+  bool closed = false, poisoned = false, completion_proved = true;
+  std::optional<dnnl::engine> engine;
+  std::optional<dnnl::stream> stream;
+  std::unique_ptr<Allocation> scratch; // ONE reusable allocation, not per shape
+  struct Entry {
+    Shape s;
+    MD x, w, y, scratch_desc;
+    dnnl::matmul::primitive_desc pd;
+    dnnl::matmul primitive;
+    Plan plan;
+  };
+  struct Pending {
+    std::shared_ptr<Entry> entry;
+    std::unordered_map<int,dnnl::memory> args;
+    std::optional<sycl::event> event;
+  };
+  std::list<std::shared_ptr<Entry>> cache;
+  std::list<Pending> pending;
+  std::optional<sycl::event> last_event;
+  Stats counters;
+
+  Impl(std::shared_ptr<Runtime> rt, const sycl::queue& queue, size_t bytes)
+      : runtime(std::move(rt)), q(checked_queue(runtime,queue)), limit(bytes) {
+    if (limit > max_temporary_bytes)
+      throw std::invalid_argument("oneDNN BF16 temporary budget exceeds 128 MiB");
+  }
+  void healthy() {
+    if (closed) throw std::logic_error("oneDNN BF16 object is closed");
+    if (poisoned) throw std::runtime_error("oneDNN BF16 object is poisoned");
+    try { runtime->check(); }
+    catch (...) { poisoned=true; throw; }
+  }
+  void ensure_engine() {
+    if (engine) return;
+    const auto* v = dnnl_version();
+    if (!v || v->major != DNNL_VERSION_MAJOR || v->minor != DNNL_VERSION_MINOR ||
+        v->patch != DNNL_VERSION_PATCH || v->gpu_runtime != DNNL_RUNTIME_SYCL ||
+        !v->hash || std::string_view(v->hash) != DNNL_VERSION_HASH)
+      throw std::runtime_error("loaded oneDNN does not match inspected SYCL GPU headers/source identity");
+    // This API derives the engine kind from the explicit supplied GPU device.
+    // It does NOT select engine(gpu,ordinal), a CPU engine or a default queue.
+    auto e = api("make_engine(caller GPU/context)",[&] {
+      return dnnl::sycl_interop::make_engine(q.get_device(),q.get_context());
+    });
+    if (e.get_kind() != dnnl::engine::kind::gpu ||
+        dnnl::sycl_interop::get_device(e) != q.get_device() ||
+        dnnl::sycl_interop::get_context(e) != q.get_context())
+      throw std::runtime_error("oneDNN did not return the supplied GPU/context");
+    auto st = api("make_stream(caller in-order queue)",[&] {
+      return dnnl::sycl_interop::make_stream(e,q);
+    });
+    if (dnnl::sycl_interop::get_queue(st) != q)
+      throw std::runtime_error("oneDNN did not wrap the supplied queue");
+    engine.emplace(std::move(e));
+    stream.emplace(std::move(st));
+  }
+  void drain() {
+    // Never discard owners on an uncertain wait outcome. User scratch sharing
+    // and eviction both use this same safe boundary, including partial enqueue.
+    try {
+      if (stream) stream->wait();
+      q.wait();
+    } catch (...) { poisoned = true; throw; }
+    completion_proved = true;
+    pending.clear();
+    last_event.reset();
+    ++counters.completion_drains;
+    std::exception_ptr error;
+    try { q.throw_asynchronous(); } catch (...) { error = std::current_exception(); }
+    try { runtime->check(); } catch (...) { if (!error) error = std::current_exception(); }
+    if (error) { poisoned = true; std::rethrow_exception(error); }
+  }
+  void reap() {
+    while (!pending.empty()) {
+      const auto& e = pending.front().event;
+      if (!e || e->get_info<sycl::info::event::command_execution_status>() !=
+                    sycl::info::event_command_status::complete) break;
+      pending.pop_front();
+    }
+  }
+  void evict() {
+    reap();
+    if (cache.back().use_count() > 1) {
+      ++counters.capacity_drains;
+      drain();
+    }
+    counters.primitive_owned_memory_bytes -= cache.back()->plan.primitive_owned_memory_bytes;
+    cache.pop_back();
+  }
+  std::shared_ptr<Entry> get(const Shape& s) {
+    healthy();
+    for (auto it=cache.begin(); it!=cache.end(); ++it) {
+      if ((*it)->s.key() == s.key()) {
+        auto result = *it;
+        cache.splice(cache.begin(),cache,it);
+        ++counters.cache_hits;
+        return result;
+      }
+    }
+    ensure_engine();
+    ++counters.cache_misses;
+    MD x({s.t,s.k},DT::bf16,{s.k,1});
+    MD w({s.k,s.n},DT::bf16,{1,s.k}); // W[N,K] transposed view, no reorder
+    MD y({s.t,s.n},DT::bf16,{s.ld,1});
+    dnnl::primitive_attr attr;
+    attr.set_accumulation_mode(dnnl::accumulation_mode::strict);
+    attr.set_fpmath_mode(dnnl::fpmath_mode::strict);
+    attr.set_scratchpad_mode(dnnl::scratchpad_mode::user);
+    attr.set_rounding_mode(DNNL_ARG_DST,dnnl::rounding_mode::environment);
+    auto pd = api("strict BF16/BF16->BF16 matmul descriptor",[&] {
+      return dnnl::matmul::primitive_desc(*engine,x,w,y,attr);
+    });
+    const auto actual = pd.get_primitive_attr();
+    Plan p;
+    p.implementation = pd.impl_info_str();
+    p.device = q.get_device().get_info<sycl::info::device::name>();
+    p.driver = q.get_device().get_info<sycl::info::device::driver_version>();
+    p.queue_backend = static_cast<int>(q.get_backend());
+    p.library_hash = dnnl_version()->hash;
+    p.library_cache_capacity = dnnl::get_primitive_cache_capacity();
+    p.t=s.t; p.n=s.n; p.k=s.k; p.ldy=s.ld;
+    p.gpu_engine = pd.get_engine().get_kind() == dnnl::engine::kind::gpu;
+    p.same_queue_context_device =
+        dnnl::sycl_interop::get_context(pd.get_engine()) == q.get_context() &&
+        dnnl::sycl_interop::get_device(pd.get_engine()) == q.get_device() &&
+        dnnl::sycl_interop::get_queue(*stream) == q;
+    p.strict_accumulation = actual.get_accumulation_mode() == dnnl::accumulation_mode::strict;
+    p.strict_fpmath = actual.get_fpmath_mode() == dnnl::fpmath_mode::strict;
+    p.user_scratchpad = actual.get_scratchpad_mode() == dnnl::scratchpad_mode::user;
+    p.environment_rounding = actual.get_rounding_mode(DNNL_ARG_DST) == dnnl::rounding_mode::environment;
+    p.exact_bf16_descriptors = pd.src_desc()==x && pd.weights_desc()==w && pd.dst_desc()==y;
+    if (!p.gpu_engine || !p.same_queue_context_device || !p.strict_accumulation ||
+        !p.strict_fpmath || !p.user_scratchpad || !p.environment_rounding ||
+        !p.exact_bf16_descriptors || actual.get_post_ops().len()!=0 ||
+        x.get_size()>s.xb || w.get_size()>s.wb || y.get_size()>s.yb)
+      throw std::runtime_error("oneDNN changed requested GPU/BF16/stride/strict contract");
+    auto sd = pd.scratchpad_desc();
+    p.scratchpad_bytes = sd.get_size();
+    if (pd.workspace_desc().get_size()!=0)
+      throw std::runtime_error("oneDNN matmul requested an unsupported persistent workspace");
+    if (p.scratchpad_bytes) {
+      const auto se=pd.scratchpad_engine();
+      if (se.get_kind()!=dnnl::engine::kind::gpu || se.get()!=engine->get() ||
+          dnnl::sycl_interop::get_context(se)!=q.get_context() ||
+          dnnl::sycl_interop::get_device(se)!=q.get_device())
+        throw std::runtime_error("oneDNN scratchpad engine differs from caller GPU engine");
+    }
+    // The C++ query_s64 helper silently returns zero on query error. Use the
+    // public C query with a checked status so UNKNOWN never becomes zero cost.
+    dnnl_dim_t owned=0;
+    api("primitive-owned memory query",[&] {
+      dnnl::error::wrap_c_api(dnnl_primitive_desc_query(pd.get(),
+          dnnl_query_memory_consumption_s64,0,&owned),"memory consumption query failed");
+    });
+    if (owned < 0)
+      throw std::runtime_error("oneDNN reported an unknown negative primitive memory size");
+    if (uint64_t(owned) > uint64_t(limit) || p.scratchpad_bytes > limit)
+      throw OneDnnBf16TemporaryLimit("oneDNN descriptor temporary memory exceeds object budget");
+    p.primitive_owned_memory_bytes = size_t(owned);
+    p.full_fp32_output_equivalent_bytes = s.fp32_equivalent;
+    const size_t scratch_reserve = std::max(counters.scratch_allocated_bytes,p.scratchpad_bytes);
+    if (p.primitive_owned_memory_bytes > limit-scratch_reserve)
+      throw OneDnnBf16TemporaryLimit("oneDNN scratch plus primitive memory exceeds object budget");
+    // Evict BEFORE primitive creation: total wrapper-owned primitive residency
+    // is <=32, including in-flight entries. A retired in-flight entry is drained.
+    while (!cache.empty() &&
+        (cache.size()>=max_cached_shapes || counters.primitive_owned_memory_bytes >
+         limit-scratch_reserve-p.primitive_owned_memory_bytes)) evict();
+    auto e = std::make_shared<Entry>(Entry{
+        s,std::move(x),std::move(w),std::move(y),std::move(sd),pd,dnnl::matmul(pd),p});
+    cache.push_front(e);
+    counters.primitive_owned_memory_bytes += p.primitive_owned_memory_bytes;
+    return e;
+  }
+  void ensure_scratch(size_t bytes) {
+    if (bytes <= counters.scratch_allocated_bytes) return;
+    if (bytes > limit || counters.primitive_owned_memory_bytes > limit-bytes)
+      throw OneDnnBf16TemporaryLimit("oneDNN shared scratch exceeds object temporary budget");
+    drain(); // old scratch wrappers and work finish before resize/free
+    scratch.reset();
+    counters.scratch_allocated_bytes = 0;
+    // Release old storage BEFORE allocating replacement: no doubled peak.
+    auto storage = std::make_unique<Allocation>(runtime,bytes,MemoryKind::Device);
+    validate_device_span(storage->data(),bytes,q);
+    scratch = std::move(storage);
+    counters.scratch_allocated_bytes = bytes;
+    counters.peak_scratch_bytes = std::max(counters.peak_scratch_bytes,bytes);
+  }
+  sycl::event execute(std::shared_ptr<Entry> e, const uint16_t* x,
+                      const uint16_t* w, uint16_t* y) {
+    healthy();
+    ensure_scratch(e->plan.scratchpad_bytes);
+    reap();
+    if (pending.size()>=max_pending_arguments) {
+      ++counters.capacity_drains;
+      drain();
+    }
+    Pending call;
+    call.entry=std::move(e);
+    call.args.emplace(DNNL_ARG_SRC,dnnl::sycl_interop::make_memory(
+        call.entry->x,*engine,Kind::usm,const_cast<uint16_t*>(x)));
+    call.args.emplace(DNNL_ARG_WEIGHTS,dnnl::sycl_interop::make_memory(
+        call.entry->w,*engine,Kind::usm,const_cast<uint16_t*>(w)));
+    call.args.emplace(DNNL_ARG_DST,dnnl::sycl_interop::make_memory(
+        call.entry->y,*engine,Kind::usm,y));
+    if (call.entry->plan.scratchpad_bytes) {
+      validate_device_span(scratch->data(),call.entry->plan.scratchpad_bytes,q);
+      call.args.emplace(DNNL_ARG_SCRATCHPAD,dnnl::sycl_interop::make_memory(
+          call.entry->scratch_desc,*engine,Kind::usm,scratch->data()));
+    }
+    std::vector<sycl::event> deps;
+    if (last_event) deps.push_back(*last_event);
+    // Allocate every wrapper/node/dependency BEFORE submission. Retain the
+    // whole call if an exception could have followed partial native enqueue.
+    pending.push_back(std::move(call));
+    auto& owned=pending.back();
+    completion_proved=false;
+    try {
+      auto event=api("BF16 primitive execute",[&] {
+        return dnnl::sycl_interop::execute(owned.entry->primitive,*stream,owned.args,deps);
+      });
+      owned.event.emplace(event);
+      last_event.emplace(event); // explicit scratch dependency plus in-order queue
+      ++counters.executes;
+      return event;
+    } catch (...) { poisoned=true; throw; }
+  }
+  void close() {
+    if (closed) return;
+    std::exception_ptr error;
+    try { drain(); }
+    catch (...) {
+      if (!completion_proved) throw;
+      error=std::current_exception();
+    }
+    cache.clear();
+    counters.primitive_owned_memory_bytes=0;
+    scratch.reset();
+    counters.scratch_allocated_bytes=0;
+    stream.reset();
+    engine.reset();
+    closed=true;
+    if (error) std::rethrow_exception(error);
+  }
+};
+
+OneDnnFaithfulBf16::OneDnnFaithfulBf16(std::shared_ptr<Runtime> rt,
+    const sycl::queue& q, size_t limit) : impl_(std::make_unique<Impl>(std::move(rt),q,limit)) {}
+OneDnnFaithfulBf16::~OneDnnFaithfulBf16() noexcept {
+  if (!impl_ || impl_->closed) return;
+  try { impl_->close(); }
+  catch (...) {
+    // Completion/error must never disappear into a noexcept destructor while
+    // oneDNN/USM owners are released. Main supervises failed/hung GPU children.
+    std::fputs("oneDNN BF16 destructor close failed; stopping before owner destruction\n",stderr);
+    std::fflush(stderr);
+    std::terminate();
+  }
+}
+OneDnnFaithfulBf16::Plan OneDnnFaithfulBf16::prepare(int64_t t,int64_t n,int64_t k,int64_t ld) {
+  return impl_->get(shape(t,n,k,ld))->plan;
+}
+sycl::event OneDnnFaithfulBf16::submit(const uint16_t* x,const uint16_t* w,uint16_t* y,
+    int64_t t,int64_t n,int64_t k,int64_t ld,float beta) {
+  const auto s=shape(t,n,k,ld,beta);
+  impl_->healthy();
+  validate_spans({{y,s.yb}},{{x,s.xb},{w,s.wb}},2);
+  validate_device_span(x,s.xb,impl_->q);
+  validate_device_span(w,s.wb,impl_->q);
+  validate_device_span(y,s.yb,impl_->q);
+  return impl_->execute(impl_->get(s),x,w,y);
+}
+void OneDnnFaithfulBf16::wait() {
+  if (impl_->closed) throw std::logic_error("oneDNN BF16 object is closed");
+  impl_->drain();
+}
+void OneDnnFaithfulBf16::close() { impl_->close(); }
+OneDnnFaithfulBf16::Stats OneDnnFaithfulBf16::stats() const {
+  auto s=impl_->counters;
+  s.cached_shapes=impl_->cache.size(); s.pending_arguments=impl_->pending.size();
+  s.closed=impl_->closed; s.poisoned=impl_->poisoned;
+  return s;
+}
