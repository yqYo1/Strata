+namespace strata::sycl_backend::qsa_device_profile {
+using Stamp = cpu_wait_profile::Stamp;
+inline void require(bool ok, const char* reason) {
+    if (!ok) throw std::runtime_error(reason);
+}
+inline uint64_t add(uint64_t a, uint64_t b) {
+    require(b <= std::numeric_limits<uint64_t>::max() - a, "QSA device profile: duration overflow");
+    return a + b;
+}
+struct Submission {
+    // Queue is BORROWED. No runtime/context/queue owner and no back reference.
+    sycl::queue* queue = nullptr;
+    std::optional<sycl::event> event;
+    int layer = -1, chunk = -1, mode = -1, direct = -1, native = -1, mapping = -1;
+    int64_t token_start = 0, queries = 0, key_length = 0, cap = 0;
+    Stamp entry{}, returned{}, api_entry{}, api_returned{};
+    uint64_t submit = 0, start = 0, end = 0;
+    bool typed = false, begun = false, host_returned = false, threw = false, api_begun = false, api_done = false;
+    const char* route() const noexcept { return typed ? "typed_bf16_attention" : "fp32_attention"; }
+};
+
+// Exported diagnostic attention API boundary includes its validation and host
+// dispatch. This is a separate span from the narrower queue.submit boundary.
+class ApiSpan {
+    Submission* s_;
+    int exceptions_ = 0;
+public:
+    explicit ApiSpan(Submission* s) : s_(s) {
+        if (!s_) return;
+        require(!s_->api_begun, "QSA device profile: reused API span");
+        exceptions_ = std::uncaught_exceptions();
+        s_->api_begun = true;
+        s_->api_entry = cpu_wait_profile::stamp();
+    }
+    ~ApiSpan() noexcept {
+        if (!s_) return;
+        s_->api_returned = cpu_wait_profile::stamp(); s_->api_done = true;
+        if (std::uncaught_exceptions() > exceptions_) s_->threw = true;
+    }
+    ApiSpan(const ApiSpan&) = delete;
+    ApiSpan& operator=(const ApiSpan&) = delete;
+};
+
+// Construct immediately before queue.submit. Its destructor records a throwing
+// host return but never waits, queries an event, allocates or changes error state.
+class SubmitSpan {
+    Submission* s_;
+public:
+    SubmitSpan(Submission* s, sycl::queue& queue, int mode, int direct, int native, int mapping) : s_(s) {
+        if (!s_) return;
+        require(s_->queue == &queue && !s_->begun, "QSA device profile: wrong queue or reused submission");
+        s_->mode = mode; s_->direct = direct; s_->native = native; s_->mapping = mapping;
+        s_->begun = true;
+        s_->entry = cpu_wait_profile::stamp();
+    }
+    void returned(const sycl::event& event) {
+        if (!s_) return;
+        s_->returned = cpu_wait_profile::stamp();
+        s_->host_returned = true;
+        // All record/optional storage was allocated BEFORE request submission.
+        // If the implementation's event copy throws, the outer checked lease
+        // still owns every reader/buffer and this slot until queue retirement.
+        try { s_->event.emplace(event); }
+        catch (...) { s_->threw = true; throw; }
+    }
+    ~SubmitSpan() noexcept {
+        if (s_ && !s_->host_returned) {
+            s_->returned = cpu_wait_profile::stamp();
+            s_->host_returned = true; s_->threw = true;
+        }
+    }
+    SubmitSpan(const SubmitSpan&) = delete;
+    SubmitSpan& operator=(const SubmitSpan&) = delete;
+};
+
+class Profile {
+public:
+    // At most 1024 chunks * 12 attention layers; no sampling/truncation.
+    static constexpr size_t max_chunks = 1024, max_records = 12 * max_chunks;
+    // One route/queue/mode per request, with full and optional tail query shape.
+    static constexpr size_t max_groups = 24;
+    static size_t capacity(int64_t n, int64_t chunk) {
+        require(n > 0 && n <= 262144 && chunk > 0 && chunk <= 8192,
+                "QSA device profile: unsupported context/chunk");
+        const auto chunks = uint64_t(1 + (n - 1) / chunk);
+        require(chunks <= max_chunks, "QSA device profile: requires ceil(tokens/chunk)<=1024 (12288 events)");
+        return size_t(chunks) * 12;
+    }
+    // Finite accounting allowance for backend event implementations as well as
+    // our exact slots. The runtime's internal event byte cost is not specified.
+    static uint64_t host_reservation(int64_t n, int64_t chunk) {
+        return uint64_t(sizeof(Profile)) + uint64_t(capacity(n, chunk)) * (sizeof(Submission) + 4096);
+    }
+    static void check_queue(sycl::queue& queue) {
+        require(queue.get_device().has(sycl::aspect::queue_profiling),
+                "QSA device profile: device lacks aspect::queue_profiling");
+        require(queue.has_property<sycl::property::queue::enable_profiling>(),
+                "QSA device profile: existing queue lacks enable_profiling");
+        require(queue.has_property<sycl::property::queue::in_order>(),
+                "QSA device profile: existing queue must be in_order");
+    }
+    Profile(sycl::queue& queue, int64_t n, int64_t pos0, int64_t chunk, int64_t cap,
+            int64_t max_cells, bool native16, bool typed, uint64_t layers)
+        : queue_(&queue), backend_(queue.get_backend()), n_(n), pos0_(pos0), chunk_(chunk), cap_(cap),
+          max_cells_(max_cells), native16_(native16), typed_(typed), layers_(layers), expected_(capacity(n, chunk)) {
+        check_queue(queue);
+        require(pos0 >= 0 && max_cells > 0 && max_cells <= 262144 && pos0 <= max_cells &&
+                n <= max_cells - pos0 && cap > 0 && (!typed || native16),
+                "QSA device profile: invalid position, capacity, selection or route");
+        unsigned count = 0;
+        for (int l = 0; l < 48; ++l) count += unsigned((layers >> l) & 1);
+        require(count == 12 && !(layers >> 48), "QSA device profile: requires twelve attention layers");
+        request_id_ = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count());
+        records_ = std::make_unique<Submission[]>(expected_); // all slots, before GPU work
+    }
+    ~Profile() noexcept {
+        // The enclosing existing lease must run before this owner, even when a
+        // submit or callback throws. Do not silently release on an unsafe path.
+        if (!retired_) {
+            std::fputs("QSA device profile: releasing live records without checked drain; aborting\n", stderr);
+            std::fflush(stderr); std::abort();
+        }
+        if (!emitted_) emit_incomplete(); // no queries/claimed completed samples
+    }
+    Profile(const Profile&) = delete;
+    Profile& operator=(const Profile&) = delete;
+
+    Submission* reserve(int layer, int64_t token_start, int64_t queries, int64_t key_length,
+                        int64_t cap, bool typed) {
+        require(!finished_ && layer >= 0 && layer < 48 && ((layers_ >> layer) & 1) &&
+                used_ < expected_ && cap == cap_ && typed == typed_ &&
+                token_start == pos0_ + int64_t(seen_[size_t(layer)]) * chunk_ &&
+                token_start < pos0_ + n_ && queries == std::min(chunk_, pos0_ + n_ - token_start) &&
+                key_length == token_start + queries,
+                "QSA device profile: unexpected layer/chunk/route/shape or record capacity");
+        auto& s = records_[used_++];
+        s.queue = queue_; s.layer = layer; s.chunk = int(seen_[size_t(layer)]++);
+        s.token_start = token_start; s.queries = queries; s.key_length = key_length;
+        s.cap = cap; s.typed = typed;
+        // Conservatively dirty before entering any attention validation/submit,
+        // including a partial runtime submission that throws without an event.
+        retired_ = false;
+        return &s;
+    }
+    // Call only after BOTH existing checked stream drains have succeeded.
+    // No SYCL API call here, and no new retirement/synchronization operation.
+    void checked_drain() noexcept { retired_ = true; }
+
+    // Only the successful terminal request/lease-retirement seam calls this.
+    // The timestamps remain in a backend clock domain; host clocks stay separate.
+    void finish(double request_wall_ms, bool coarse_complete, bool qsa_complete) {
+        require(retired_ && !finished_ && used_ == expected_ && used_ &&
+                coarse_complete && qsa_complete && std::isfinite(request_wall_ms) && request_wall_ms >= 0,
+                "QSA device profile: incomplete request, drain, section observer or event count");
+        const auto chunks = uint64_t(expected_ / 12);
+        for (int l = 0; l < 48; ++l)
+            require(seen_[size_t(l)] == (((layers_ >> l) & 1) ? chunks : 0),
+                    "QSA device profile: missing attention layer/chunk");
+        uint64_t prior_start = 0, union_end = 0;
+        for (size_t i = 0; i < used_; ++i) {
+            auto& s = records_[i];
+            require(s.begun && s.host_returned && s.api_begun && s.api_done && !s.threw && s.event.has_value() &&
+                    cpu_wait_profile::duration(s.api_entry.wall) &&
+                    cpu_wait_profile::duration(s.api_returned.wall - s.api_entry.wall) && s.entry.wall >= s.api_entry.wall &&
+                    s.api_returned.wall >= s.returned.wall &&
+                    cpu_wait_profile::duration(s.returned.wall - s.entry.wall),
+                    "QSA device profile: missing event or invalid host span");
+            if (s.entry.valid && s.returned.valid)
+                require(cpu_wait_profile::duration(s.returned.cpu - s.entry.cpu),
+                        "QSA device profile: invalid issuing-thread submit CPU span");
+            if (s.api_entry.valid && s.api_returned.valid)
+                require(cpu_wait_profile::duration(s.api_returned.cpu - s.api_entry.cpu),
+                        "QSA device profile: invalid issuing-thread API CPU span");
+            // This is deliberately AFTER checked terminal drain. Even the
+            // status query must not be used to manufacture retirement proof.
+            require(s.event->get_backend() == backend_ &&
+                    s.event->get_info<sycl::info::event::command_execution_status>() ==
+                        sycl::info::event_command_status::complete,
+                    "QSA device profile: backend mismatch or event not complete after drain");
+            s.submit = s.event->get_profiling_info<sycl::info::event_profiling::command_submit>();
+            s.start = s.event->get_profiling_info<sycl::info::event_profiling::command_start>();
+            s.end = s.event->get_profiling_info<sycl::info::event_profiling::command_end>();
+            require(s.submit <= s.start && s.start <= s.end && (!i || s.start >= prior_start),
+                    "QSA device profile: invalid/nonmonotonic device timestamps");
+            sum_ns_ = add(sum_ns_, s.end - s.start);
+            // Same checked backend, one existing in-order queue. Start ordering
+            // is verified above, so a streaming interval union needs no sort.
+            union_ns_ = add(union_ns_, i ? s.end - std::min(s.end, std::max(s.start, union_end)) : s.end - s.start);
+            union_end = std::max(union_end, s.end); prior_start = s.start;
+            auto& g = group(s);
+            ++g.count; g.duration_ns = add(g.duration_ns, s.end - s.start);
+            g.submit_to_start_ns = add(g.submit_to_start_ns, s.start - s.submit);
+            g.host_s += s.returned.wall - s.entry.wall;
+            g.api_s += s.api_returned.wall - s.api_entry.wall;
+            if (s.api_entry.valid && s.api_returned.valid) { ++g.api_cpu_count; g.api_cpu_s += s.api_returned.cpu - s.api_entry.cpu; }
+            if (s.entry.valid && s.returned.valid) { ++g.cpu_count; g.cpu_s += s.returned.cpu - s.entry.cpu; }
+            g.key_min = std::min(g.key_min, s.key_length); g.key_max = std::max(g.key_max, s.key_length);
+        }
+        request_wall_ms_ = request_wall_ms;
+        finished_ = true;
+        emit();
+    }
+private:
+    struct Group {
+        const Submission* shape = nullptr;
+        uint64_t count = 0, cpu_count = 0, api_cpu_count = 0, duration_ns = 0, submit_to_start_ns = 0;
+        double host_s = 0, cpu_s = 0, api_s = 0, api_cpu_s = 0;
+        int64_t key_min = 262144, key_max = 0;
+    };
+    Group& group(const Submission& s) {
+        for (auto& g : groups_) {
+            if (!g.shape) { g.shape = &s; return g; }
+            const auto& a = *g.shape;
+            if (a.layer == s.layer && a.typed == s.typed && a.queries == s.queries && a.cap == s.cap &&
+                a.mode == s.mode && a.direct == s.direct && a.native == s.native && a.mapping == s.mapping) return g;
+        }
+        throw std::runtime_error("QSA device profile: unexpected shape/kernel group count");
+    }
+    void emit_incomplete() noexcept {
+        emitted_ = true;
+        std::fprintf(stderr, "strata qsa device: {\"v\":1,\"kind\":\"request\",\"observer\":\"own-qsa-device-events-v1\",\"complete\":false,\"request_id\":%llu,\"normal_retirement\":%s,\"reserved_records\":%zu,\"expected_records\":%zu,\"completed_samples_emitted\":0,\"proposal_base_source\":\"6354f0b4ff3731466795410e11ca9ef785c9d326\",\"flags\":{\"STRATA_PREFILL_QSA_DEVICE_PROFILE\":1,\"STRATA_PREFILL_LAYER_MAJOR\":1,\"STRATA_PREFILL_LAYER_MAJOR_PROFILE\":1,\"STRATA_PREFILL_LAYER_MAJOR_QSA_PROFILE\":1,\"native16_bf16\":%s,\"typed_qsa\":%s},\"reason\":\"request_or_observer_not_completed\",\"numerical_correctness\":\"not_checked_by_observer\"}\n",
+                     (unsigned long long)request_id_, retired_ ? "true" : "false", used_, expected_,
+                     native16_ ? "true" : "false", typed_ ? "true" : "false");
+    }
+    void identity(const Submission& s) const noexcept {
+        std::fprintf(stderr, "\"request_id\":%llu,\"queue_id\":\"request_compute_0\",\"layer\":%d,\"route\":\"%s\",\"queries\":%lld,\"cap\":%lld,\"kv_heads\":2,\"head_dim\":256,\"kernel\":{\"family\":\"%s\",\"mode\":%d,\"direct\":%d,\"native_kv\":%d,\"mapping\":%d}",
+                     (unsigned long long)request_id_, s.layer, s.route(), (long long)s.queries, (long long)s.cap,
+                     s.typed ? "launch_prompt_bf16" : "launch", s.mode, s.direct, s.native, s.mapping);
+    }
+    void emit() noexcept {
+        // JSONL: <=12288 event rows, <=24 shape rows and one terminal summary.
+        // Every row is bounded, no tensor/API log, comfortably below 16 MiB.
+        for (size_t i = 0; i < used_; ++i) {
+            const auto& s = records_[i];
+            std::fprintf(stderr, "strata qsa device: {\"v\":1,\"kind\":\"event\",\"id\":%zu,", i);
+            identity(s);
+            std::fprintf(stderr, ",\"chunk\":%d,\"token_start\":%lld,\"key_length\":%lld,\"host_entry_s\":%.17g,\"host_return_s\":%.17g,\"host_submit_span_s\":%.17g,\"issuing_thread_cpu_s\":",
+                         s.chunk, (long long)s.token_start, (long long)s.key_length,
+                         s.entry.wall, s.returned.wall, s.returned.wall - s.entry.wall);
+            if (s.entry.valid && s.returned.valid) std::fprintf(stderr, "%.17g", s.returned.cpu - s.entry.cpu);
+            else std::fputs("null", stderr);
+            std::fprintf(stderr, ",\"host_api_entry_s\":%.17g,\"host_api_return_s\":%.17g,\"host_api_span_s\":%.17g,\"api_issuing_thread_cpu_s\":",
+                         s.api_entry.wall, s.api_returned.wall, s.api_returned.wall - s.api_entry.wall);
+            if (s.api_entry.valid && s.api_returned.valid) std::fprintf(stderr, "%.17g", s.api_returned.cpu - s.api_entry.cpu);
+            else std::fputs("null", stderr);
+            std::fprintf(stderr, ",\"device_submit_ns\":%llu,\"device_start_ns\":%llu,\"device_end_ns\":%llu,\"event_duration_ns\":%llu,\"submit_to_start_ns\":%llu}\n",
+                         (unsigned long long)s.submit, (unsigned long long)s.start, (unsigned long long)s.end,
+                         (unsigned long long)(s.end - s.start), (unsigned long long)(s.start - s.submit));
+        }
+        for (const auto& g : groups_) {
+            if (!g.shape) break;
+            std::fputs("strata qsa device: {\"v\":1,\"kind\":\"aggregate\",", stderr);
+            identity(*g.shape);
+            std::fprintf(stderr, ",\"count\":%llu,\"key_length_min\":%lld,\"key_length_max\":%lld,\"nonexclusive_event_duration_sum_ns\":%llu,\"submit_to_start_sum_ns\":%llu,\"host_submit_span_sum_s\":%.17g,\"issuing_thread_cpu_sum_s\":%.17g,\"cpu_sample_count\":%llu,\"host_api_span_sum_s\":%.17g,\"api_issuing_thread_cpu_sum_s\":%.17g,\"api_cpu_sample_count\":%llu}\n",
+                         (unsigned long long)g.count, (long long)g.key_min, (long long)g.key_max,
+                         (unsigned long long)g.duration_ns, (unsigned long long)g.submit_to_start_ns,
+                         g.host_s, g.cpu_s, (unsigned long long)g.cpu_count,
+                         g.api_s, g.api_cpu_s, (unsigned long long)g.api_cpu_count);
+        }
+        std::fprintf(stderr, "strata qsa device: {\"v\":1,\"kind\":\"request\",\"observer\":\"own-qsa-device-events-v1\",\"proposal_base_source\":\"6354f0b4ff3731466795410e11ca9ef785c9d326\",\"complete\":true,\"request_id\":%llu,\"normal_retirement\":true,\"numerical_correctness\":\"not_checked_by_observer\",\"coarse_complete\":true,\"qsa_sections_complete\":true,\"tokens\":%lld,\"pos0\":%lld,\"chunk\":%lld,\"physical_context\":%lld,\"event_count\":%zu,\"expected_records\":%zu,\"queue_id\":\"request_compute_0\",\"queue_identity\":\"%p\",\"backend_enum\":%d,\"same_backend_verified\":true,\"queue_profiling_supported\":true,\"enable_profiling\":true,\"flags\":{\"STRATA_PREFILL_QSA_DEVICE_PROFILE\":1,\"STRATA_PREFILL_LAYER_MAJOR\":1,\"STRATA_PREFILL_LAYER_MAJOR_PROFILE\":1,\"STRATA_PREFILL_LAYER_MAJOR_QSA_PROFILE\":1,\"native16_bf16\":%s,\"typed_qsa\":%s},\"request_wall_ms\":%.17g,\"wall_boundary\":\"layer_major_started_through_checked_lease_retirement_excludes_emit_and_teardown\",\"nonexclusive_event_duration_sum_ns\":%llu,\"attention_interval_union_ns\":%llu,\"clock_domains\":\"host_steady_s_and_same_backend_device_ns_no_alignment\",\"key_length_semantics\":\"logical_cache_end_not_selected_cell_count\",\"submit_to_start_semantics\":\"queue_dependency_runtime_device_dispatch_delay_not_host_CPU\",\"critical_path\":\"unresolved\",\"exclusive_GPU_service\":\"unresolved\",\"occupancy\":\"unmeasured\"}\n",
+                     (unsigned long long)request_id_, (long long)n_, (long long)pos0_, (long long)chunk_, (long long)max_cells_, used_, expected_,
+                     static_cast<void*>(queue_), int(backend_), native16_ ? "true" : "false", typed_ ? "true" : "false",
+                     request_wall_ms_, (unsigned long long)sum_ns_, (unsigned long long)union_ns_);
+        emitted_ = true;
+    }
+    sycl::queue* queue_;
+    sycl::backend backend_;
+    int64_t n_, pos0_, chunk_, cap_, max_cells_;
+    bool native16_, typed_;
+    uint64_t layers_, request_id_ = 0;
+    size_t expected_, used_ = 0;
+    std::unique_ptr<Submission[]> records_;
+    std::array<uint64_t, 48> seen_{};
+    std::array<Group, max_groups> groups_{};
+    uint64_t sum_ns_ = 0, union_ns_ = 0;
+    double request_wall_ms_ = 0;
+    bool retired_ = true, finished_ = false, emitted_ = false;
+};
+
+// Declare the owner before this borrow and the existing Restore/checked lease.
+struct Borrow {
+    Profile*& slot;
+    Profile* prior;
+    Borrow(Profile*& target, Profile* value) noexcept : slot(target), prior(target) { slot = value; }
+    ~Borrow() noexcept { slot = prior; }
+};
