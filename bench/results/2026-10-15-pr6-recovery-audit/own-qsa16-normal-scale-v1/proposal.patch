+// Independent normal-result oracle uses exact FP64 arithmetic, not exponent
+// rewriting. The second device result always calls the old SYCL ldexp directly;
+// fallback checks compare raw bits, including signed zero and NaN payloads.
+struct ScoreScaleInput {
+  uint32_t bits; int shift;
+  bool operator==(const ScoreScaleInput &) const = default;
+};
+struct ScoreScaleOutput { uint32_t fast_bits, old_bits; };
+struct ScoreProductInput {
+  uint32_t value_bits, scale_bits; int shift;
+  bool operator==(const ScoreProductInput &) const = default;
+};
+struct ScoreProductOutput { uint32_t product_bits, fast_bits, old_bits; };
+void score_scale_fixture() {
