+// SPDX-License-Identifier: MIT
+// Original Strata implementation; see the repository LICENSE.
+#pragma once
+
+#include <cstdint>
+#include <limits>
+#include <sycl/sycl.hpp>
+
+namespace strata::kernels::detail {
+
+static_assert(sizeof(float) == sizeof(uint32_t) &&
+              std::numeric_limits<float>::is_iec559 &&
+              std::numeric_limits<float>::radix == 2 &&
+              std::numeric_limits<float>::digits == 24 &&
+              std::numeric_limits<float>::min_exponent == -125 &&
+              std::numeric_limits<float>::max_exponent == 128);
+
+// The input is the already-rounded value * (K_scale * .0625f), never qdown.
+// A normal binary32 value is sign * (1 + mantissa / 2^23) * 2^(exponent-127).
+// If the target exponent is also 1..254, changing only that field is exact.
+// Test shift bounds BEFORE adding it, including for INT_MIN / INT_MAX.
+// All other inputs/results retain the original ldexp operation and arguments.
+inline float prompt_bf16_score_scale(float value, int shift) {
+  const uint32_t bits = sycl::bit_cast<uint32_t>(value);
+  const int exponent = int((bits >> 23) & 0xffU);
+  if (exponent > 0 && exponent < 255 &&
+      shift >= 1 - exponent && shift <= 254 - exponent) {
+    const uint32_t target = uint32_t(exponent + shift);
+    return sycl::bit_cast<float>((bits & 0x807fffffU) | (target << 23));
+  }
+  return sycl::ldexp(value, shift);
+}
+
+} // namespace strata::kernels::detail
