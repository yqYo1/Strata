+  std::vector<ScoreScaleInput> cases;
+  cases.reserve(1100000);
+  for (uint32_t sign : {0U,0x80000000U})
+    for (uint32_t exponent = 1; exponent <= 254; ++exponent)
+      for (uint32_t mantissa : mantissas)
+        for (int target = 1; target <= 254; ++target)
+          cases.push_back({sign | (exponent << 23) | mantissa,target-int(exponent)});
