+            if(r.calls_after!=r.calls_before+1 || r.overflow_after || ctl[2]<=0 || ctl[2]>r.slots || r.slots>=65536) {
+                err="terminal ordinary KV resolve count/overflow/miss mismatch";return false;
+            }
