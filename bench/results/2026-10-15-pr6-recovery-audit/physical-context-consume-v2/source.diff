+            std::array<int32_t,65536> blocks;
+            copy(blocks.data(),st.map.miss_block,size_t(ctl[2])*sizeof(int32_t));
+            const auto terminal_block=(input-1)/4;
+            const int at=first_prior_miss(blocks.data(),ctl[2],terminal_block,r.pages);
