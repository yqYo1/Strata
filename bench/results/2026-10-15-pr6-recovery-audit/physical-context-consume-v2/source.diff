+        std::fflush(stderr);std::abort();
+    }
+    static void copy(void* out,const void* in,size_t bytes) {
+        if(!in || cudaMemcpy(out,in,bytes,cudaMemcpyDeviceToHost)!=cudaSuccess) uncertain("bounded copy");
+    }
+    bool begin(const core::SessionState& ss,const core::ModelGeometry& g,int64_t resident,void* stream,std::string& err) {
+        if(begun || !stream || g.n_head_kv!=2 || g.head_dim!=256 || ss.qsa_alloc!=12) {
+            err="unsupported observer geometry/state";return false;
+        }
+        if(cudaStreamSynchronize(static_cast<cudaStream_t>(stream))!=cudaSuccess) uncertain("prefill retirement");
+        requested=resident;
