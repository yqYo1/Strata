+                "\"resolve_misses\":%llu,\"resolve_lookups\":%llu,\"overflow_before\":%d,\"overflow_after\":%d,"
+                "\"probe_scope\":\"one_selected_prior_block_host_vs_resolved_slot_not_all_context\","
+                "\"probe_block\":%d,\"probe_slot\":%d,\"probe_bytes\":%zu,\"probe_fnv1a64\":\"%016llx\"}",
