+               (r.mode==1 && (!r.host || st.kv_hybrid || st.map.n_slots!=r.slots || st.map.n_blocks!=r.pages ||
+                   st.map.page_table!=st.page_table || !st.map.ctl || !st.map.miss_block || !st.map.miss_slot || !st.map.slot_block))) {
