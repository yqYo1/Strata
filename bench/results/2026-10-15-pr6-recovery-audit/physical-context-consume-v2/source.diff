+                if(!host || !device || stride>backing.size()-used) return false;
+                copy(backing.data()+used,static_cast<const uint8_t*>(host)+size_t(r.probe_block)*stride,stride);
+                copy(slot.data()+used,static_cast<const uint8_t*>(device)+size_t(r.probe_slot)*stride,stride);
