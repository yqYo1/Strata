+// Independently authored for Strata; repository LICENSE applies.
+// Source delivery only. Main must review and qualify every execution separately.
+#include "ze_api.h"
+#include "zet_api.h"
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <dlfcn.h>
+#include <iomanip>
