+void append_completed_blocks(sycl::queue &q, const float *raw, int base,
+                             const float *gamma, float eps, QsaIndexerBuffers b,
+                             detail::QsaIndexerDeviceBatchPlan plan, Angles a) {
+  q.submit([&](sycl::handler &h) {
+    sycl::local_accessor<float, 1> values(128, h), partials(8, h);
+    h.parallel_for(
+        sycl::nd_range<1>(plan.block_global, 256),
+        [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(32)]] {
+          const int pos = 4 * (int(plan.first_block) + int(item.get_group_linear_id())) + 3;
+          const int d = item.get_local_linear_id();
+          float mean = 0;
+          if (d < 128) {
+            const int64_t first = int64_t(pos) - 3;
+            const float incoming = float(sycl::half(raw[size_t(int64_t(pos) - plan.p0) * 128 + d]));
