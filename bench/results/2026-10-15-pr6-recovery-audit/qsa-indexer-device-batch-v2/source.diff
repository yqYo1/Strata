+            need(k::rope_table_for(sc).cos==cosine.data(),"set STRATA_ROPE_TABLE=1 before exec for table modes");
+        } else need(k::rope_table_for(sc).cos==nullptr,"analytic mode requires no registered RoPE table");
+    }
+    ~Tables() noexcept {
+        if(!drain()) fatal();
+        if(active) { k::mrope_table_set(nullptr);k::rope_table_release(cosine.data()); }
+    }
+};
+static void selection(const State& a,const State& b,int64_t end) {
+    const auto shape=k::qsa_real_shapes();
+    std::vector<int64_t> counts;
+    for(int64_t n:{int64_t(1),int64_t(3),int64_t(4),int64_t(5),int64_t(2051),int64_t(2052),end})
+        if(n<=end && std::find(counts.begin(),counts.end(),n)==counts.end()) counts.push_back(n);
+    const size_t nq=counts.size(),blocks=size_t(a.capacity/4+1),cap=2051;
+    std::vector<float> queries(nq*512),sentinel(nq*blocks,-987.f);
+    std::vector<int32_t> steps(nq*k::kStepCount),ids(nq*cap+16,-777);
+    for(size_t i=0;i<queries.size();++i) queries[i]=float(std::sin(double(i)*.071));
+    for(size_t q=0;q<nq;++q) {
+        steps[q*4]=int32_t(counts[q]-1);steps[q*4+1]=int32_t(counts[q]);
+        steps[q*4+2]=int32_t(counts[q]/4);steps[q*4+3]=int32_t(std::min<int64_t>(counts[q],2051));
+    }
+    Buffer<float> query(queries.size()),score_a(sentinel.size()),score_b(sentinel.size());
+    Buffer<int32_t> step(steps.size()),id_a(ids.size()),id_b(ids.size());
+    pd::DraftUploadGuard lease(drain,fatal);lease.arm();
+    query.put(queries);step.put(steps);score_a.put(sentinel);score_b.put(sentinel);id_a.put(ids);id_b.put(ids);
+    const auto av=a.view(),bv=b.view();auto* stream=&rt->compute();
+    const int64_t active=end/4+1;
+    k::qsa_block_scores(av.pooled,av.dead,query.data(),step.data(),int64_t(nq),int64_t(blocks),shape,score_a.data(),stream,active);
+    k::qsa_block_scores(bv.pooled,bv.dead,query.data(),step.data(),int64_t(nq),int64_t(blocks),shape,score_b.data(),stream,active);
+    k::qsa_block_topk(score_a.data(),step.data(),int64_t(nq),int64_t(blocks),int64_t(cap),shape,id_a.data(),stream,active);
+    k::qsa_block_topk(score_b.data(),step.data(),int64_t(nq),int64_t(blocks),int64_t(cap),shape,id_b.data(),stream,active);
+    const auto sa=score_a.get(),sbv=score_b.get();const auto ia=id_a.get(),ib=id_b.get();
+    need(exact(sa,sbv) && exact(ia,ib),"causal scores/top-k selected IDs differ");
+    for(size_t q=0;q<nq;++q) {
+        const size_t width=size_t(std::min<int64_t>(counts[q],2051));
+        for(size_t j=0;j<width;++j) {
+            const int32_t id=ia[q*cap+j];need(id>=0 && id<counts[q],"future/invalid causal selected ID");
+            if(j) need(ia[q*cap+j-1]<id,"selected IDs sorted and unique");
+            if(counts[q]<=2051) need(id==int32_t(j),"identity selection boundary");
+        }
+        for(size_t j=width;j<cap;++j) need(ia[q*cap+j]==-777,"ID width canary");
+        for(size_t j=size_t(counts[q]/4+1);j<blocks;++j) need(sa[q*blocks+j]==-987.f,"future block score mask");
+    }
+    for(size_t i=nq*cap;i<ia.size();++i) need(ia[i]==-777,"ID allocation canary");
+    need(drain(),"selection final drain");lease.retire();++selection_comparisons;
+}
+static void candidate(const float* raw,int64_t n,int64_t p0,int base,const float* gamma,
+                      const State& state,const k::RopeScaling& sc,bool dispatch) {
+    if(dispatch) k::native_qsa_indexer_append_batch(raw,n,p0,base,gamma,1e-6f,state.view(),k::qsa_real_shapes(),state.capacity,sc,&rt->compute());
+    else k::native_qsa_indexer_append_device_batch(raw,n,p0,base,gamma,1e-6f,state.view(),k::qsa_real_shapes(),state.capacity,sc,&rt->compute());
+}
+static void sequence(int64_t p0,const std::vector<int64_t>& chunks,int64_t capacity,
+                     const k::RopeScaling& sc,bool dispatch,bool restore_midway) {
+    const int base=100;const int64_t end=p0+std::accumulate(chunks.begin(),chunks.end(),int64_t(0));
+    need(end<=capacity,"fixture end capacity");
+    std::vector<float> raw(size_t(end)*128),weight(128);
+    std::vector<int32_t> positions(static_cast<size_t>(end));
+    for(size_t i=0;i<raw.size();++i) {
+        raw[i]=float(std::sin(double(i)*.713)*(1+int(i%11)));
+        switch(i%257) {
+        case 0:raw[i]=0.f;break;case 1:raw[i]=-0.f;break;
+        case 2:raw[i]=0x1p-24f;break;case 3:raw[i]=-0x1p-24f;break;
+        case 4:raw[i]=0x1p-25f;break;case 5:raw[i]=1.f+0x1p-11f;break;
+        default:break;
+        }
+    }
+    for(size_t d=0;d<128;++d) weight[d]=.5f+float(d%17)*.01f;
+    std::iota(positions.begin(),positions.end(),int32_t(0));
+    Buffer<float> input(raw.size()),gamma(128);Buffer<int32_t> pos(positions.size());
+    State oracle(capacity),batched(capacity);
+    std::unique_ptr<State> restored;Image saved;
+    pd::DraftUploadGuard lease(drain,fatal);lease.arm();
+    input.put(raw);gamma.put(weight);pos.put(positions);
+    auto append_one=[&](const State& s,int64_t p) {
+        k::native_qsa_indexer_append(input.data()+size_t(p)*128,pos.data()+p,base,gamma.data(),1e-6f,
+                                     s.view(),k::qsa_real_shapes(),capacity,sc,&rt->compute());
+    };
+    // A real contiguous oracle history, including the physical suite's full
+    // prefix. Clone only after its checked completion; independent allocations.
+    for(int64_t p=0;p<p0;++p) append_one(oracle,p);
+    saved=oracle.image();batched.restore(saved);compare(oracle,batched);
+    int64_t p=p0;
+    for(size_t c=0;c<chunks.size();++c) {
+        const int64_t count=chunks[c];State& dst=restored?*restored:batched;
+        for(int64_t i=0;i<count;++i) append_one(oracle,p+i);
+        candidate(input.data()+size_t(p)*128,count,p,base,gamma.data(),dst,sc,dispatch);
+        p+=count;compare(oracle,dst);selection(oracle,dst,p);
+        if(restore_midway && c==2 && c+1<chunks.size()) {
+            saved=dst.image();restored=std::make_unique<State>(capacity);restored->restore(saved);
+            // Same moving spare publication as checkpoint restore. Completed
+            // pooled rows/tail/dead/block_pos came from the exact saved image.
+            const auto v=restored->view();copy_checked(v.pooled+size_t(p/4)*128,v.dead,512);
+            compare(oracle,*restored);
+        }
+    }
+    const State& final=restored?*restored:batched;
+    compare(oracle,final);need(exact(input.get(),raw) && exact(gamma.get(),weight),"read-only inputs unchanged");
+    if(capacity==262144 && end==capacity) {
+        const auto image=final.image();
+        need(image.block[guard]==base+262140,"physical last block_pos");
+        need(std::memcmp(image.pooled.data()+guard+65536ull*128,image.dead.data()+guard,512)==0,"physical spare row65536 exact");
+        final.check_guards(image); // Next physical row65537 remains the canary.
+    }
+    need(drain(),"state final drain");lease.retire();
+}
+static void invalid(const k::RopeScaling& sc,bool dispatch) {
+    std::vector<float> raw(8*128,.1f),weight(128,1.f);
+    Buffer<float> input(raw.size()),gamma(128);State state(32);
+    sycl::queue unordered(rt->context(),rt->device());
+    std::unique_ptr<sycl::queue> foreign;
+    if(k::mrope_table() || k::rope_table_for(sc).cos) {
+        sycl::context context(rt->device());
+        foreign=std::make_unique<sycl::queue>(context,rt->device(),sycl::property_list{sycl::property::queue::in_order{}});
+    }
+    auto both=[&]() noexcept { try { unordered.wait_and_throw();if(foreign) foreign->wait_and_throw();rt->wait();return true; } catch(...) { return false; } };
+    pd::DraftUploadGuard lease(both,fatal);lease.arm();input.put(raw);gamma.put(weight);
+    const auto before=state.image();const auto shape=k::qsa_real_shapes();
+    auto call=[&](int64_t n,int64_t p,int32_t base,int64_t cap,float eps,k::QsaShapes s,
+                  k::QsaIndexerBuffers view,void* stream,const float* x,const float* g) {
+        if(dispatch) k::native_qsa_indexer_append_batch(x,n,p,base,g,eps,view,s,cap,sc,stream);
+        else k::native_qsa_indexer_append_device_batch(x,n,p,base,g,eps,view,s,cap,sc,stream);
+    };
+    auto rejects=[&](auto action) {
+        // Every negative case has its own full-allocation before/after image,
+        // including BOTH guard rows. Fence all fixture queues even if a broken
+        // validator unexpectedly submitted work before returning/throwing.
+        const auto before_case=state.image();state.check_guards(before_case);
+        bool caught=false;try { action(); } catch(const std::invalid_argument&) { caught=true; }
+        need(both(),"negative-case queues retired before state inspection");
+        const auto after_case=state.image();state.check_guards(after_case);
+        need(exact(before_case.tail,after_case.tail) && exact(before_case.dead,after_case.dead) &&
+             exact(before_case.pooled,after_case.pooled) && exact(before_case.block,after_case.block),
+             "negative case changed state bytes before rejection");
+        ++state_comparisons;++invalid_unchanged_checks;
+        need(caught,"invalid candidate argument was accepted");++invalid_rejections;
+    };
+    for(const auto& pair:std::vector<std::pair<int64_t,int64_t>>{{-1,0},{1,-1},{8,28},{1,33},{INT64_MAX,0}})
+        rejects([&]{call(pair.first,pair.second,100,32,1e-6f,shape,state.view(),&rt->compute(),input.data(),gamma.data());});
+    for(int base:{-4,2,2147483644})
+        rejects([&]{call(8,0,base,32,1e-6f,shape,state.view(),&rt->compute(),input.data(),gamma.data());});
+    for(int64_t cap:{int64_t(0),int64_t(INT32_MAX)+1})
+        rejects([&]{call(8,0,100,cap,1e-6f,shape,state.view(),&rt->compute(),input.data(),gamma.data());});
+    for(float eps:{0.f,-1.f,std::bit_cast<float>(0x7fc00000u)})
+        rejects([&]{call(8,0,100,32,eps,shape,state.view(),&rt->compute(),input.data(),gamma.data());});
+    for(int mode=0;mode<3;++mode) {
+        auto s=shape;if(mode==0)s.idx_dim=127;else if(mode==1)s.idx_block=3;else s.n_rot=32;
+        rejects([&]{call(8,0,100,32,1e-6f,s,state.view(),&rt->compute(),input.data(),gamma.data());});
+    }
+    rejects([&]{call(8,0,100,32,1e-6f,shape,state.view(),nullptr,input.data(),gamma.data());});
+    rejects([&]{call(8,0,100,32,1e-6f,shape,state.view(),&unordered,input.data(),gamma.data());});
+    if(foreign) rejects([&]{call(8,0,100,32,1e-6f,shape,state.view(),foreign.get(),input.data(),gamma.data());});
+    rejects([&]{call(8,0,100,32,1e-6f,shape,state.view(),&rt->compute(),nullptr,gamma.data());});
+    rejects([&]{call(8,0,100,32,1e-6f,shape,state.view(),&rt->compute(),input.data(),nullptr);});
+    rejects([&]{call(8,0,100,32,1e-6f,shape,state.view(),&rt->compute(),
+        reinterpret_cast<const float*>(reinterpret_cast<const uint8_t*>(input.data())+2),gamma.data());});
+    rejects([&]{call(8,0,100,32,1e-6f,shape,state.view(),&rt->compute(),input.data(),misaligned(gamma.data()));});
+    for(int member=0;member<4;++member) {
+        auto view=state.view();
+        if(member==0) view.tail=misaligned(view.tail);
+        else if(member==1) view.dead=misaligned(view.dead);
+        else if(member==2) view.pooled=misaligned(view.pooled);
+        else view.block_pos=misaligned(view.block_pos);
+        rejects([&]{call(8,0,100,32,1e-6f,shape,view,&rt->compute(),input.data(),gamma.data());});
+    }
+    // Representative aligned state-state aliases, independent of raw/gamma
+    // aliases above/below: dead within tail, pooled overlapping tail, and
+    // block_pos within pooled. All must reject with every state byte intact.
+    for(int overlap=0;overlap<3;++overlap) {
+        auto view=state.view();
+        if(overlap==0) view.dead=view.tail;
+        else if(overlap==1) view.pooled=view.tail;
+        else view.block_pos=reinterpret_cast<int32_t*>(view.pooled);
+        rejects([&]{call(8,0,100,32,1e-6f,shape,view,&rt->compute(),input.data(),gamma.data());});
+    }
+    rejects([&]{call(8,0,100,32,1e-6f,shape,state.view(),&rt->compute(),state.view().pooled,gamma.data());});
+    rejects([&]{call(8,0,100,32,1e-6f,shape,state.view(),&rt->compute(),input.data(),state.view().tail);});
+    auto alias=state.view();alias.block_pos=reinterpret_cast<int32_t*>(alias.dead);
+    rejects([&]{call(8,0,100,32,1e-6f,shape,alias,&rt->compute(),input.data(),gamma.data());});
+    auto missing=state.view();missing.tail=nullptr;
+    rejects([&]{call(8,0,100,32,1e-6f,shape,missing,&rt->compute(),input.data(),gamma.data());});
+    auto bad_scaling=sc;bad_scaling.freq_base=1;
+    rejects([&]{k::native_qsa_indexer_append_device_batch(input.data(),8,0,100,gamma.data(),1e-6f,
+        state.view(),shape,32,bad_scaling,&rt->compute());});
+    call(0,32,100,32,1e-6f,shape,state.view(),&rt->compute(),input.data(),gamma.data());
+    need(drain(),"invalid argument final drain");
+    const auto after=state.image();state.check_guards(after);
+    need(exact(before.tail,after.tail) && exact(before.dead,after.dead) && exact(before.pooled,after.pooled) && exact(before.block,after.block),"invalid input partially submitted state changes");
+    ++state_comparisons;
+    need(both(),"all fixture queues retired");lease.retire();
+}
+int main(int argc,char** argv) {
+    try {
+        need(argc==6,"usage: fixture small|large|physical|invalid none|linear|yarn analytic|full|short plain|mrope direct|dispatch");
+        const std::string suite=argv[1],scale=argv[2],table=argv[3],mapping=argv[4],api=argv[5];
+        need(suite=="small"||suite=="large"||suite=="physical"||suite=="invalid","suite");
+        need(scale=="none"||scale=="linear"||scale=="yarn","scaling");
+        need(table=="analytic"||table=="full"||table=="short","table");
+        need(mapping=="plain"||mapping=="mrope","mrope");need(api=="direct"||api=="dispatch","API");
+        const bool dispatch=api=="dispatch",multi=mapping=="mrope";
+        if(dispatch) {
+            const char* value=std::getenv("STRATA_SYCL_QSA_INDEXER_DEVICE_BATCH");
+            need(value && std::strcmp(value,"1")==0,"dispatch fixture requires immutable flag=1 before exec");
+        }
+        k::RopeScaling sc;
+        if(scale!="none") { sc.type=scale=="linear"?k::RopeScalingType::Linear:k::RopeScalingType::YaRN;sc.factor=4;sc.ext_factor=scale=="yarn"?1:0; }
+        rt=sb::runtime_for();
+        const int maxpos=suite=="physical"?262244:20000;
+        Tables tables(sc,maxpos,table,multi);tables.activate(sc,maxpos,table,multi);
+        if(suite=="small") {
+            // Each sequence constructs fresh independent oracle/candidate
+            // states. n>1 forces the actual seed + batch/finalizer path;
+            // these cases cannot pass merely through the n==1 fallback.
+            for(int64_t n:{int64_t(2),int64_t(3),int64_t(4)}) {
+                sequence(0,{n},64,sc,dispatch,false);
+                ++fresh_zero_multicell_batches;
+            }
+            for(int64_t p0:{int64_t(0),int64_t(1),int64_t(3),int64_t(4),int64_t(5)})
+                sequence(p0,{1,2,3,5,4,1,7,2},64,sc,dispatch,true);
+        } else if(suite=="large") {
+            sequence(0,{4096,4096,3},16384,sc,dispatch,false);
+            sequence(5,{8192,3},16384,sc,dispatch,false);
+        } else if(suite=="physical") sequence(262140,{4},262144,sc,dispatch,false);
+        else invalid(sc,dispatch);
+        need(drain(),"fixture complete queue fence");
+        std::cout<<"{\"version\":1,\"arm\":\"native_qsa_indexer_device_batch\",\"suite\":\""<<suite<<
+            "\",\"scaling\":\""<<scale<<"\",\"table\":\""<<table<<"\",\"mapping\":\""<<mapping<<
+            "\",\"api\":\""<<api<<"\",\"status\":\"complete\",\"state_comparisons\":"<<state_comparisons<<
+            ",\"selection_comparisons\":"<<selection_comparisons<<
+            ",\"fresh_zero_multicell_batches\":"<<fresh_zero_multicell_batches<<
+            ",\"invalid_rejections\":"<<invalid_rejections<<
+            ",\"invalid_unchanged_checks\":"<<invalid_unchanged_checks<<
+            ",\"kernel_mechanics_only\":true,\"physical_model_context_qualified\":false,\"restore_qualified\":false,\"performance_qualified\":false}\n";
+    } catch(const std::exception& e) { std::cerr<<e.what()<<'\n';return 1; }
+}
