+// Diagnostic proposal: no SYCL/driver dependency and no device work of its own.
+#pragma once
+#include <cstdint>
+#include <string>
+
+#if defined(STRATA_EXTERNAL_SESSION_PROFILE_V2) && defined(__linux__)
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <unistd.h>
+#endif
+
+namespace strata::core::external_profile {
+#if defined(STRATA_EXTERNAL_SESSION_PROFILE_V2) && defined(__linux__)
+struct State {
+    // Read only this non-secret path. No environment write or environ scan.
+    const char* path = std::getenv("STRATA_EXTERNAL_SESSION_PROFILE_DIR");
+    uint64_t request = 0, decode = 0;
+    const void* selected = nullptr;
+    bool eligible = false, consumed = false;
+    int tx = -1, rx = -1;
+    unsigned records = 0, bytes = 0;
+    ~State() { if (tx >= 0) ::close(tx); if (rx >= 0) ::close(rx); }
+    bool enabled() const { return path && *path; }
+    static uint64_t raw() {
+        timespec t{};
+        return ::clock_gettime(CLOCK_MONOTONIC_RAW, &t) == 0 ?
+            uint64_t(t.tv_sec)*1000000000ull + uint64_t(t.tv_nsec) : 0;
+    }
+    bool open_channels() {
+        if (tx >= 0 && rx >= 0) return true;
+        if (!enabled() || path[0] != '/') return false;
+        int dir = ::open(path, O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);
+        if (dir < 0) return false;
+        struct stat v{};
+        bool ok = ::fstat(dir, &v) == 0 && v.st_uid == ::getuid() &&
+            (v.st_mode & 0777) == 0700;
+        int fds[2] = {-1, -1};
+        const char* names[2] = {"markers", "acks"};
+        for (int i=0; ok && i<2; ++i) {
+            // RDWR keeps failure bounded by the deadline instead of SIGPIPE/EOF
+            // or open(2) waiting forever when the controller has died.
+            fds[i] = ::openat(dir, names[i], O_RDWR|O_NONBLOCK|O_NOFOLLOW|O_CLOEXEC);
+            ok = fds[i] >= 0 && ::fstat(fds[i], &v) == 0 && S_ISFIFO(v.st_mode) &&
+                v.st_uid == ::getuid() && (v.st_mode & 0777) == 0600 && v.st_nlink == 1;
+        }
+        ::close(dir);
+        if (!ok) { for (int fd : fds) if (fd >= 0) ::close(fd); return false; }
+        tx=fds[0]; rx=fds[1]; return true;
+    }
+};
+inline State& state() { static State s; return s; }
+inline void request(bool eligible) {
+    State& s=state();
+    if (!s.enabled()) return;
+    ++s.request; s.decode=0; s.selected=nullptr;
+    s.eligible=eligible && s.request==1 && !s.consumed;
+}
+inline void attempt(const void* verifier) {
+    State& s=state();
+    if (!s.enabled()) return;
+    ++s.decode; s.selected=s.eligible && s.decode==8 ? verifier : nullptr;
+}
+
+class Window {
+    State* s_ = nullptr;
+    const void* verifier_;
+    int T_;
+    int64_t pos_, layers_;
+    uint64_t window_;
+    const void *compute_, *copy_;
+    bool valid_=false, started_=false, paused_=false, finished_=false;
+    bool emit(const char* phase) {
+        if (!s_ || !s_->open_channels() || s_->records>=16) return false;
+        const uint64_t raw=State::raw();
+        if (!raw) return false;
+        char b[512];
+        const int n=std::snprintf(b,sizeof(b),
+            "PROFILE2 phase=%s raw_ns=%llu pid=%ld tid=%ld request=%llu decode=%llu "
+            "verifier=%p window=%llu T=%d pos=%lld layers=%lld compute=%p copy=%p work=normal_mtp4\n",
+            phase,(unsigned long long)raw,(long)::getpid(),(long)::syscall(SYS_gettid),
+            (unsigned long long)s_->request,(unsigned long long)s_->decode,verifier_,
+            (unsigned long long)window_,T_,(long long)pos_,(long long)layers_,compute_,copy_);
+        if (n<=0 || size_t(n)>=sizeof(b) || s_->bytes+unsigned(n)>8192) return false;
+        ++s_->records; s_->bytes+=unsigned(n);
+        // Single <= PIPE_BUF nonblocking write: no partial record fallback.
+        return ::write(s_->tx,b,size_t(n))==n;
+    }
+    bool exchange(const char* phase, std::string& err) {
+        const uint64_t begin=State::raw();
+        if (!begin || !emit(phase)) { err="external profile: marker failure"; return false; }
+        char expected[128];
+        const int need=std::snprintf(expected,sizeof(expected),"ACK %s %ld %llu\n",phase,
+                                    (long)::getpid(),(unsigned long long)window_);
+        char got[128]; size_t used=0;
+        // Finite host handshake OUTSIDE the normal verifier work boundaries.
+        // This is diagnostic intrusion, never a clean performance measurement.
+        for (;;) {
+            const uint64_t now=State::raw();
+            if (!now || now<begin || now-begin>=5000000000ull) break;
+            pollfd p{s_->rx,POLLIN,0};
+            const int remaining=int((5000000000ull-(now-begin)+999999)/1000000);
+            const int ready=::poll(&p,1,remaining);
+            if (ready<0 && errno==EINTR) continue;
+            if (ready<=0 || p.revents&(POLLERR|POLLNVAL)) break;
+            const ssize_t n=::read(s_->rx,got+used,sizeof(got)-used);
+            if (n<0 && (errno==EAGAIN || errno==EINTR)) continue;
+            if (n<=0) break;
+            used+=size_t(n);
+            if (std::memchr(got,'\n',used)) {
+                if (need>0 && size_t(need)==used && std::memcmp(got,expected,used)==0) return true;
+                break;
+            }
+            if (used==sizeof(got)) break;
+        }
+        err="external profile: missing/invalid ack or 5s deadline"; return false;
+    }
+public:
+    Window(const void* verifier,int T,int64_t pos,uint64_t actual_window,
+           const void* compute,const void* copy,int64_t layers,bool warm,bool whole)
+        :verifier_(verifier),T_(T),pos_(pos),layers_(layers),window_(actual_window),
+         compute_(compute),copy_(copy) {
+        State& s=state();
+        if (!s.enabled() || s.consumed || s.selected!=verifier) return;
+        s.consumed=true; s.selected=nullptr; s_=&s;
+        valid_=T==4 && warm && whole;
+    }
+    Window(const Window&)=delete;
+    Window& operator=(const Window&)=delete;
+    bool before_launch(std::string& err) {
+        if (!s_) return true;
+        if (!valid_) { emit("MISSED"); finished_=true; return true; }
+        if (!exchange("START",err)) return false;
+        started_=true;
+        if (!emit("ACTIVE")) { err="external profile: active marker failed"; return false; }
+        return true;
+    }
+    bool drained(std::string& err) {
+        if (!s_ || !valid_) return true;
+        if (!started_ || !exchange("DRAINED",err)) return false;
+        paused_=true;
+        if (!emit("PAUSED")) { err="external profile: paused marker failed"; return false; }
+        return true;
+    }
+    bool finish(std::string& err) {
+        if (!s_ || !valid_) return true;
+        if (!paused_ || !emit("FINISHED")) { err="external profile: finish marker failed"; return false; }
+        finished_=true; return true;
+    }
+    ~Window() {
+        // Never add a device drain or wait/pause from an error destructor.
+        if (s_ && !finished_) emit("FAILED");
+    }
+};
+#else
+inline void request(bool) {}
+inline void attempt(const void*) {}
+class Window {
+public:
+    Window(const void*,int,int64_t,uint64_t,const void*,const void*,int64_t,bool,bool) {}
+    bool before_launch(std::string&) { return true; }
+    bool drained(std::string&) { return true; }
+    bool finish(std::string&) { return true; }
+};
+#endif
+} // namespace strata::core::external_profile
