+namespace strata::program::consume_prompt {
+inline bool cli_flag(const char* arg) { return arg && !std::strcmp(arg,"--consume-prompt"); }
+inline bool context_admitted(bool consume, int64_t max_new, int64_t limit, size_t input) {
+    if (consume) return max_new>=0 && limit>0 && limit<=262144 && input>=2 && uint64_t(input)<=uint64_t(limit);
+    return max_new>0 && limit>0 && max_new<=limit && input<=size_t(limit-max_new);
+}
+struct Admission {
+    bool sycl=false, standalone=false, native_cli=false, single_gpu=false;
+    bool mtp4=false, prefill=false, full_kv=false, ple=false;
+    bool no_token_graph=false, suffix_disabled=false, no_competing_diagnostics=false;
+};
+inline bool supported(const Admission& a) {
+    return a.sycl && a.standalone && a.native_cli && a.single_gpu && a.mtp4 && a.prefill &&
+        a.full_kv && a.ple && a.no_token_graph && a.suffix_disabled && a.no_competing_diagnostics;
+}
+struct Coverage {
+    int64_t expected=0, next=0, callbacks=0, last_begin=-1, last_count=0;
+    explicit Coverage(int64_t n=0):expected(n){}
+    bool can_accept(int64_t begin,int64_t count) const {
+        return begin==next && count>0 && begin>=0 && begin<=expected && count<=expected-begin;
+    }
+    bool accept(int64_t begin,int64_t count) {
+        if(!can_accept(begin,count)) return false;
+        last_begin=begin;last_count=count;next+=count;++callbacks;return true;
+    }
+    bool complete() const {return next==expected;}
+};
+struct Terminal {
+    int64_t position=-1,token=-1;
+    int windows=0;
+    bool run=false,commit=false,wait=false;
+    bool begin(bool first,int T,int64_t p,int64_t x,int64_t input,int64_t last,size_t emitted,
+               const Coverage& coverage) {
+        if(windows || !first || T!=1 || p!=input-1 || x!=last || emitted || !coverage.complete() ||
+           coverage.expected!=input-1) return false;
+        position=p;token=x;++windows;return true;
+    }
+    bool ran() {if(windows!=1 || run)return false;run=true;return true;}
+    bool committed(int rows) {if(!run || commit || rows!=1)return false;commit=true;return true;}
+    bool waited() {if(!commit || wait)return false;wait=true;return true;}
+    bool complete(size_t emitted) const {return windows==1 && run && commit && wait && emitted==0;}
+};
+// Stable bounded receipt fingerprint; external controller additionally pins
+// token-file SHA256. This is explicitly FNV-1a over signed IDs encoded i64 LE.
+inline uint64_t token_fingerprint(const int64_t* ids,size_t n) {
+    uint64_t h=14695981039346656037ULL;
+    for(size_t i=0;i<n;++i) {uint64_t x=uint64_t(ids[i]);for(int b=0;b<8;++b){h^=(x>>(8*b))&255;h*=1099511628211ULL;}}
+    return h;
+}
