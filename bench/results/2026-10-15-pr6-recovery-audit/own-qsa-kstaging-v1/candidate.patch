+// Main-owned experimental memory schedule; no numerical or default change.
+bool qsa_bf16_prefix_kstage_batch(const uint16_t *query, const QsaAttnPools &pools,
+    const int32_t *ids, const int32_t *steps, int64_t cap, const QsaShapes &shape,
+    uint16_t *output, int64_t queries, const QsaPromptBf16Bounds &bounds,
+    int64_t live_cells, const QsaBf16PackedScratch &scratch, void *stream, int span) {
+  if (span == 1) return qsa_bf16_prefix_optimized_batch(query, pools, ids, steps,
+      cap, shape, output, queries, bounds, live_cells, scratch, stream);
+  if (span == 4) return prefix_batch_impl<Cells + 1, false, false, 4>(query,
+      pools, ids, steps, cap, shape, output, queries, bounds, live_cells, scratch, stream);
+  if (span == Dim) return prefix_batch_impl<Cells + 1, false, false, Dim>(query,
+      pools, ids, steps, cap, shape, output, queries, bounds, live_cells, scratch, stream);
+  throw std::invalid_argument("experimental K span must be 1, 4 or256");
