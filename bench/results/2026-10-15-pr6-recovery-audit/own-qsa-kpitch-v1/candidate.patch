+// Main-owned experimental row pitch; no producer ownership or arithmetic change.
+bool qsa_bf16_prefix_pitch_batch(const uint16_t *query, const QsaAttnPools &pools,
+    const int32_t *ids, const int32_t *steps, int64_t cap, const QsaShapes &shape,
+    uint16_t *output, int64_t queries, const QsaPromptBf16Bounds &bounds,
+    int64_t live_cells, const QsaBf16PackedScratch &scratch, void *stream, int variant) {
+  if (variant == 0) return qsa_bf16_prefix_optimized_batch(query, pools, ids, steps,
+      cap, shape, output, queries, bounds, live_cells, scratch, stream);
+  if (variant == 1) return prefix_batch_impl<Cells + 1, false, false, 36, 256>(query,
+      pools, ids, steps, cap, shape, output, queries, bounds, live_cells, scratch, stream);
+  if (variant == 2) return prefix_batch_impl<Cells + 1, false, false, 32, 260>(query,
+      pools, ids, steps, cap, shape, output, queries, bounds, live_cells, scratch, stream);
+  if (variant == 3) return prefix_batch_impl<Cells + 1, false, false, 36, 260>(query,
+      pools, ids, steps, cap, shape, output, queries, bounds, live_cells, scratch, stream);
+  if (variant == 4) return prefix_batch_impl<Cells + 1, false, false, 40, 264>(query,
+      pools, ids, steps, cap, shape, output, queries, bounds, live_cells, scratch, stream);
+  throw std::invalid_argument("experimental pitch variant must be0through4");
+}
