 #include <string>
 using Clock = std::chrono::steady_clock;
 
+struct Progress {
+  bool enabled = false;
+  size_t bytes = 0;
+  unsigned seq = 0;
+  void initialize() {
+    const char *v = std::getenv("STRATA_IQ_TIMING_PROGRESS");
+    enabled = v && std::strcmp(v, "1") == 0;
+  }
+  void mark(const char *phase, const char *edge, int index = -1) {
+    if (!enabled) return;
+    char line[192];
+    auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        Clock::now().time_since_epoch()).count();
+    int n = std::snprintf(line, sizeof(line),
+        "iq-progress-v3 seq=%u steady_ns=%lld phase=%s edge=%s index=%d\n",
+        seq, static_cast<long long>(ns), phase, edge, index);
+    if (n <= 0 || n >= int(sizeof(line)) || bytes + size_t(n) > 16384) {
+      enabled = false;
+      return;
+    }
+    ++seq; bytes += size_t(n);
+    if (std::fwrite(line, 1, size_t(n), stderr) != size_t(n) ||
+        std::fflush(stderr) != 0) enabled = false;
+  }
+} progress;
+
+
