+        require(m.ctl[2] == missing && u64(m.ctl, 6) == 2052 && !m.ctl[3], "T4 oracle");
+        ++state_cases;
+      }
+      Case last("max_logical_cell", full); last.add({262143, 0, 262140, 262143});
+      auto m = resolve(full, last); invariants(full, m);
