+namespace {
+std::shared_ptr<sycl_backend::Runtime> runtime;
+std::ofstream dump;
+int repetitions = 0;
+int benchmark_nq = 0;
+int case_nq = 3, case_width = 2051;
+template <class T> struct Buffer {
+  sycl_backend::Allocation mem;
+  Buffer(size_t n)
+      : mem(runtime, n * sizeof(T), sycl_backend::MemoryKind::Device) {}
+  T *data() { return mem.as<T>(); }
+  void put(const std::vector<T> &v) {
+    try { runtime->wait(
+        runtime->compute().memcpy(data(), v.data(), v.size() * sizeof(T))); } catch (...) { std::abort(); }
+  }
+  std::vector<T> get() {
+    std::vector<T> v(mem.size() / sizeof(T));
+    try { runtime->wait(runtime->compute().memcpy(v.data(), data(), mem.size())); } catch (...) { std::abort(); }
+    return v;
+  }
+};
+void check(bool c, const char *what) {
+  if (!c)
+    throw std::runtime_error(what);
+}
+uint16_t half(float x) { return std::bit_cast<uint16_t>(_Float16(x)); }
+float decode(uint16_t x) { return float(std::bit_cast<_Float16>(x)); }
+void attention(const float *q, const QsaAttnPools &p, const int32_t *ids,
+               const int32_t *steps, int64_t cap, const QsaShapes &s,
+               float *out, int64_t nq) {
+  check(qsa_prompt_attn_batch(q,p,ids,steps,cap,s,out,nq,&runtime->compute()),
+        "Mode1 matrix attention unavailable");
+}
+void run(int page_size, bool masked, bool scaled = false) {
+  constexpr int cells = 2113, cap = 2051, heads = 24, kvheads = 2,
+                dim = 256;
+  const int nq = benchmark_nq ? benchmark_nq : case_nq;
+  auto s = qsa_real_shapes();
+  s.page_size = page_size;
+  const int pages = (cells + page_size - 1) / page_size,
+            rows = pages * page_size * kvheads;
+  std::vector<int32_t> table(pages);
+  for (int i = 0; i < pages; ++i)
+    table[i] = pages - 1 - i;
+  if (masked)
+    for (int i = 0; i < pages; i += 3)
+      table[i] = -1;
+  std::vector<uint16_t> ks(rows*4), vs(ks.size());
+  std::vector<int8_t> k8(rows*dim), v8(k8.size());
+  for (size_t i=0;i<k8.size();++i) {
+    k8[i]=int8_t(int(i*7%255)-127);
+    v8[i]=int8_t(int(i*11%255)-127);
+  }
+  for (size_t i=0;i<ks.size();++i) {
+    ks[i]=half(.007f+float(i%7)*.0001f);
+    vs[i]=half(.008f+float(i%11)*.0002f);
+  }
+  // Independent FP64 oracle uses exact quantized codes and stored FP16 scales.
+  auto load = [&](bool value,int row,int d) -> double {
+    return double((value?v8:k8)[row*dim+d]) *
+           double(decode((value?vs:ks)[row*4+d/64]));
+  };
+  std::vector<float> query(nq * heads * dim);
+  for (size_t i = 0; i < query.size(); ++i)
+    query[i] = float(std::sin(i * .019)) *
+               (scaled ? (((i/dim)%12 < 8) ? 64.f : 0x1p-20f) : 1.f);
+  std::vector<int32_t> ids(nq * cap), steps(nq * kStepCount);
+  std::vector<int> counts(nq, benchmark_nq ? cap : case_width);
+  for (int b = 0; b < nq; ++b) {
+    steps[b * 4 + 3] = counts[b];
+    for (int i = 0; i < cap; ++i)
+      ids[b * cap + i] = (i * 17 + b * 3) % cells;
+    ids[b * cap + 5] = -1;
+  }
+  Buffer<uint16_t> dks(ks.size()), dvs(vs.size());
+  Buffer<int8_t> dk8(k8.size()), dv8(v8.size());
+  Buffer<int32_t> dt(table.size()), di(ids.size()), ds(steps.size());
+  Buffer<float> q(query.size()), out(query.size()+32), single(query.size()+32);
+  dks.put(ks); dvs.put(vs); dk8.put(k8); dv8.put(v8);
+  dt.put(table); di.put(ids); ds.put(steps); q.put(query);
+  QsaAttnPools p;
+  p.page_table=dt.data(); p.k_q=dk8.data(); p.v_q=dv8.data();
+  p.k_scale=dks.data(); p.v_scale=dvs.data();
+  out.put(std::vector<float>(query.size()+32,1234.f));
+  single.put(std::vector<float>(query.size()+32,1234.f));
+  struct Drain {
+    ~Drain() { try { runtime->wait(); } catch (...) { std::abort(); } }
+  } drain; // Destroyed before any allocation owner, including exceptional paths.
+  attention(q.data(), p, di.data(), ds.data(), cap, s,
+            out.data() + 16, nq);
+  auto checked_output = [&](Buffer<float> &buffer,bool require_zero) {
+    auto all=buffer.get();
+    for(int i=0;i<16;++i) {
+      check(all[i]==1234.f,"output prefix guard");
+      check(all[all.size()-16+i]==1234.f,"output suffix guard");
+    }
+    for(size_t i=16;i<all.size()-16;++i)
+      check(require_zero ? all[i]==0.f : std::isfinite(all[i]),
+            "full output finite/expected zero");
+    return all;
+  };
+  auto y=checked_output(out,false);
+  if(dump.is_open()) {
+    dump.write(reinterpret_cast<const char*>(y.data()),y.size()*sizeof(float));
+    check(bool(dump),"initial full output dump");
+  }
+  auto unchanged = [&]() {
+    check(q.get()==query && di.get()==ids && ds.get()==steps && dt.get()==table &&
+          dk8.get()==k8 && dv8.get()==v8 && dks.get()==ks && dvs.get()==vs,
+          "input immutability including current steps/table");
+  };
+  if (repetitions) {
+    runtime->wait();
+    const auto begin = std::chrono::steady_clock::now();
+    for (int r = 0; r < repetitions; ++r)
+      attention(q.data(), p, di.data(), ds.data(), cap, s,
+                out.data() + 16, nq);
+    runtime->wait();
+    const double ms = std::chrono::duration<double, std::milli>(
+        std::chrono::steady_clock::now() - begin).count();
+    check(checked_output(out,false) == y, "repeated output exact");
+    std::cout << "bounded_component nq=" << nq
+              << " cap=2051 counts=all2051 limited_oracle_queries=0,1,2,last repeats="
+              << repetitions << " total_ms=" << ms << "\n";
+  }
+
+
+  if (!benchmark_nq) {
+  for (int b = 0; b < nq; ++b) {
+    attention(q.data() + b * heads * dim, p, di.data() + b * cap,
+              ds.data() + b * kStepCount, cap, s,
+              single.data() + 16 + b * heads * dim, 1);
+    (void)checked_output(single,false);
+  }
+  check(y == checked_output(single,false), "batch/single exact with guards");
+  }
+  double worst = 0;
+  for (size_t i = 0; i < query.size(); ++i)
+    check(std::isfinite(y[16+i]), "full output finite");
+  for (int b = 0; b < nq; ++b) {
+    if (benchmark_nq && b != 0 && b != 1 && b != 2 && b != nq - 1)
+      continue; // Benchmark-only limited scalar oracle; all outputs dumped.
+    for (int h = 0; h < heads; ++h) {
+      const int count = counts[b] >= 0 && counts[b] <= cap ? counts[b] : 0;
+      std::vector<double> weights(count);
+      double mx = -INFINITY, sum = 0;
+      for (int j = 0; j < count; ++j) {
+        int cell = ids[b * cap + j],
+            page = cell < 0 ? -1 : table[cell / page_size];
+        if (page < 0) {
+          weights[j] = -INFINITY;
+          continue;
+        }
+        int row = (page * kvheads + h / 12) * page_size + cell % page_size;
+        double dot = 0;
+        for (int d = 0; d < dim; ++d)
+          dot += double(query[(b * heads + h) * dim + d]) * load(false, row, d);
+        weights[j] = dot / 16.;
+        mx = std::max(mx, weights[j]);
+      }
+      for (auto &w : weights) {
+        w = std::isfinite(w) ? std::exp(w - mx) : 0.;
+        sum += w;
+      }
+      for (int d = 0; d < dim; ++d) {
+        double ref = 0;
+        for (int j = 0; j < count; ++j) {
+          int cell = ids[b * cap + j],
+              page = cell < 0 ? -1 : table[cell / page_size];
+          if (page < 0)
+            continue;
+          int row = (page * kvheads + h / 12) * page_size + cell % page_size;
+          ref += weights[j] * load(true, row, d);
+        }
+        if (sum)
+          ref /= sum;
+        float actual = y[16+(b * heads + h) * dim + d];
+        double err = std::abs(actual - ref);
+        worst = std::max(worst, err);
+        constexpr double tolerance = 1e-5;
+        check(std::isfinite(actual) && err < tolerance * (1 + std::abs(ref)),
+              "split attention double oracle");
+      }
+    }
+  }
+  unchanged();
+  if (benchmark_nq) {
+    std::cout << "benchmark oracle=FP64_queries_0_1_2_last max_abs=" << worst
+              << " full_finite=PASS prefix_suffix_guards=PASS inputs=PASS cross_arm_exact=EXTERNAL_REQUIRED\n";
+    return;
+  }
+  // Check all missing, then restore original valid/mixed table before width gates.
+  const auto original_table=table;
+  table.assign(pages,-1); dt.put(table);
+  out.put(std::vector<float>(query.size()+32,1234.f));
+  attention(q.data(),p,di.data(),ds.data(),cap,s,out.data()+16,nq);
+  (void)checked_output(out,true); unchanged();
+  table=original_table; dt.put(table);
+  for(int width : {0,-1,cap+1}) {
+    for(int b=0;b<nq;++b) steps[b*kStepCount+kStepWidth]=width;
+    ds.put(steps);
+    out.put(std::vector<float>(query.size()+32,1234.f));
+    attention(q.data(),p,di.data(),ds.data(),cap,s,out.data()+16,nq);
+    (void)checked_output(out,true); unchanged();
+  }
+  std::cout << "case nq=" << nq << " width=" << case_width << " page=" << page_size
+            << " masked=" << masked << " scaled=" << scaled
+            << " oracle=FP64_full max_abs=" << worst
+            << " full_finite=PASS prefix_suffix_guards=PASS inputs=PASS"
+               " allmissing=PASS restored_table_width0=PASS width-1=PASS width2052=PASS\n";
+
+}
