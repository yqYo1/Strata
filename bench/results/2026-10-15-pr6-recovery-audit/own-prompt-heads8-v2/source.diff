+      for (int n : {1,3}) for (int width : {0,1,31,32,33,2051,-1,2052}) {
+        case_nq=n; case_width=width;
+        for (int page : {1,4,16}) for (bool mask : {false,true}) run(page,mask,true);
+      }
+
+    }
+    runtime->wait();
+    if (dump.is_open()) {
+      dump.flush();
+      check(bool(dump), "output dump flush failed");
+      dump.close();
+      check(!dump.fail(), "output dump close failed");
+    }
+  } catch (const std::exception &e) {
+    if (runtime) { try { runtime->wait(); } catch (...) { std::abort(); } }
+    std::cerr << e.what() << "\n";
+    return 1;
+  }
+}
