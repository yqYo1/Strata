+        cudaStreamSynchronize(cs_) != cudaSuccess) {
+        err = "decode cache: old verifier plan pointer retirement failed"; return false;
+    }
+    hits_ = {}; work_launched_ = false; work_status_ = cudaSuccess;
+    last_t_ = 0; cache_hits_detached_ = true;
