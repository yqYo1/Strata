+// Host-only publication contract shared by the opt-in prompt lease and fixtures.
+#pragma once
+#include <cstdint>
+
+namespace strata::core {
+class DecodeCachePromptState {
+public:
+    enum class Phase { ready, draining, detached, restoring, publishing, recapturing };
+    Phase phase() const { return phase_; }
+    bool ready() const { return phase_ == Phase::ready; }
+    bool begin(uint64_t slots, uint64_t bytes) {
+        if (!ready() || !slots || !bytes) return false;
+        slots_ = slots; bytes_ = bytes; done_slots_ = done_bytes_ = 0;
+        phase_ = Phase::draining; return true;
+    }
+    bool detached() { return advance(Phase::draining, Phase::detached); }
+    bool restore() { return advance(Phase::detached, Phase::restoring); }
+    // Slot fills are checked and waited individually, in saved profile order.
+    bool filled(uint64_t bytes) {
+        if (phase_ != Phase::restoring || !bytes || done_slots_ >= slots_ ||
+            bytes > bytes_ - done_bytes_) return false;
+        ++done_slots_; done_bytes_ += bytes; return true;
+    }
+    bool publish() {
+        if (phase_ != Phase::restoring || done_slots_ != slots_ || done_bytes_ != bytes_) return false;
+        phase_ = Phase::publishing; return true;
+    }
+    bool recapture() { return advance(Phase::publishing, Phase::recapturing); }
+    bool complete() { return advance(Phase::recapturing, Phase::ready); }
+private:
+    bool advance(Phase from, Phase to) {
+        if (phase_ != from) return false;
+        phase_ = to; return true;
+    }
+    Phase phase_ = Phase::ready;
+    uint64_t slots_ = 0, bytes_ = 0, done_slots_ = 0, done_bytes_ = 0;
+};
+} // namespace strata::core
