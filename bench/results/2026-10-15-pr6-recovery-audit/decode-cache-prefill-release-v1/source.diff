+
+int main() {
+    using State = strata::core::DecodeCachePromptState;
+    State s;
+    int failures = 0;
+    auto require = [&](bool ok, const char* message) {
+        if (!ok) { std::fprintf(stderr, "%s\n", message); ++failures; }
+    };
+    require(s.ready(), "default state permits decode");
+    require(!s.begin(0, 4) && s.ready(), "empty cache cannot create a lease");
+    require(s.begin(2, 9) && !s.ready(), "retirement closes decode admission");
+    require(!s.publish() && !s.complete(), "draining cannot publish or allow decode");
+    require(s.detached(), "retired reader boundary");
+    require(!s.filled(4), "cannot count upload before restoration starts");
+    require(s.restore() && s.filled(4), "first completed slot");
+    require(!s.publish(), "partial cache must never publish");
+    require(!s.filled(6) && s.filled(5), "oversized completion is refused without corrupting counts");
+    require(!s.filled(1), "extra slot is refused");
+    require(s.publish() && !s.ready(), "full upload still cannot decode");
+    require(!s.complete(), "maps without recapture do not permit decode");
+    require(s.recapture() && s.complete() && s.ready(), "all pointer readers recaptured before decode");
+    require(s.begin(1, 7) && s.detached() && s.restore() && s.filled(7) && s.publish() &&
