+    State mismatch;
+    require(mismatch.begin(2, 9) && mismatch.detached() && mismatch.restore() && mismatch.filled(9),
+            "byte total alone does not imply all slots are restored");
+    require(!mismatch.publish() && !mismatch.ready(), "unfilled second slot stays unpublished");
+    return failures ? 1 : 0;
+}
