+// Opt-in serialized prompt transaction. Included only by the SYCL generator.
+#pragma once
+#include "strata/core/decode_cache_prompt_state.hpp"
+#include "strata/core/expert_cache.hpp"
+#include "strata/core/expert_source.hpp"
+#include "strata/core/session.hpp"
+#include "strata/core/verify.hpp"
+#include "strata/kernels/cpu/expert_layout.hpp"
+#include "strata/prefill/prefill.hpp"
+#include <cuda_runtime.h>
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace strata::program::decode_cache_prefill {
+using Clock = std::chrono::steady_clock;
+inline double elapsed(Clock::time_point start) {
+    return std::chrono::duration<double, std::milli>(Clock::now() - start).count();
+}
+[[noreturn]] inline void failstop(const std::string& why) noexcept {
+    std::fprintf(stderr, "decode cache: %s; retaining live owners until process exit\n", why.c_str());
+    std::fflush(stderr); std::fflush(stdout); std::_Exit(EXIT_FAILURE);
+}
+struct RestoreLease {
+    bool complete = false;
+    ~RestoreLease() noexcept {
+        if (!complete) failstop("prompt transaction did not prove complete restoration");
+    }
+};
+struct UploadSlab {
+    void* data = nullptr;
+    ~UploadSlab() noexcept {
+        if (data && cudaFreeHost(data) != cudaSuccess) failstop("upload slab retirement failed");
+    }
+};
+struct Entry { int32_t layer, expert, slot; uint64_t bytes; };
+
+// Caller is the one request issuer, between joined session_loop/run() calls.
+// ExpertPool's run methods return only after the batch completion/park barrier.
+// Lookahead, adaptive, peers, remotes, split and token graphs are rejected by
+// the caller; main queue completion retires its callbacks before map mutation.
+inline bool run(strata::prefill::Prefill& pf, strata::core::Verifier* verifier,
+                strata::core::ExpertCache& cache, strata::core::ExpertDispatch& dispatch,
+                strata::core::TokenHits& token_hits, std::vector<int32_t>& host_res, int32_t* d_res,
+                strata::core::ExpertSource& source,
+                const std::vector<std::pair<int32_t, int32_t>>& profile,
+                int64_t layers, int64_t experts, const int64_t* ids, int64_t count, int64_t pos,
+                cudaStream_t stream, std::string& err) {
+    const auto started = Clock::now();
+    const auto& layout = strata::kernels::cpu::expert_layout();
+    if (!dispatch.decode_cache_ready || dispatch.failed || !dispatch.hits_ready() || dispatch.cache != &cache ||
+        dispatch.cache_stream != (void*) stream || !cache.valid() || cache.slots() <= 0 ||
+        cache.resident() != cache.slots() || !d_res || !stream || !layout.native ||
+        layout.n_layers != layers || layout.n_expert != experts || dispatch.cache_blob <= 0 ||
+        cache.allocation_blob_bytes() <= 0 ||
+        host_res.size() != size_t(layers * experts) || dispatch.host_res != host_res.data() ||
+        token_hits.d_res != d_res || token_hits.cache_base != dispatch.cache_base) {
+        err = "decode cache: complete fixed-profile cache and stable residency map required"; return false;
+    }
+    // Resolve the exact existing allocation, not a new admission/free-memory plan.
+    const int64_t slots = cache.slots(), arena_bytes = cache.bytes(), blob = dispatch.cache_blob;
+    const int64_t allocation_blob = cache.allocation_blob_bytes();
+    const bool per_layer = cache.per_layer_admission(), sized = cache.slot_offsets() != nullptr;
+    std::vector<int64_t> slot_sizes;
+    slot_sizes.reserve(size_t(slots));
+    for (int64_t i = 0; i < slots; ++i)
+        slot_sizes.push_back(sized ? int64_t(cache.slot_offsets()[i + 1] - cache.slot_offsets()[i]) : allocation_blob);
+    const auto saved_res = host_res; // immutable until all restore copies complete
+    std::vector<uint8_t> seen(size_t(slots), 0);
+    std::vector<Entry> entries;
+    uint64_t restored_bytes = 0, largest_blob = 0;
+    for (const auto& [layer, expert] : profile) {
+        const int32_t slot = cache.slot_of(layer, expert);
+        if (slot < 0) continue;
+        if (layer < 0 || layer >= layers || expert < 0 || expert >= experts || slot >= slots ||
+            saved_res[size_t(layer * experts + expert)] != slot) {
+            err = "decode cache: profile/current residency disagree"; return false;
+        }
+        if (seen[size_t(slot)]) continue; // repeated profile pair has one original admission
+        const uint64_t bytes = layout.blob_bytes(layer);
+        if (!bytes || bytes > uint64_t(slot_sizes[size_t(slot)]) || bytes > uint64_t(allocation_blob) ||
+            bytes > layout.max_blob ||
+            restored_bytes > UINT64_MAX - bytes) {
+            err = "decode cache: profile blob exceeds its saved slot"; return false;
+        }
+        seen[size_t(slot)] = 1;
+        entries.push_back({layer, expert, slot, bytes});
+        restored_bytes += bytes; largest_blob = std::max(largest_blob, bytes);
+    }
+    if (entries.size() != size_t(slots)) {
+        err = "decode cache: every allocated slot must have an original profile source"; return false;
+    }
+    for (int64_t l = 0; l < layers; ++l)
+        for (int64_t e = 0; e < experts; ++e)
+            if (saved_res[size_t(l * experts + e)] != cache.slot_of(l, e)) {
+                err = "decode cache: static map no longer matches cache admissions"; return false;
+            }
+    strata::core::DecodeCachePromptState state;
+    if (!state.begin(uint64_t(slots), restored_bytes)) { err = "decode cache: invalid restore plan"; return false; }
+    UploadSlab upload, readback; // declared before lease: fail-stop precedes owner destruction
+    if (cudaHostAlloc(&upload.data, size_t(largest_blob), cudaHostAllocPortable) != cudaSuccess ||
+        cudaHostAlloc(&readback.data, size_t(largest_blob), cudaHostAllocPortable) != cudaSuccess) {
+        err = "decode cache: bounded restore upload/readback slab allocation failed"; return false;
+    }
+    RestoreLease lease; // all subsequent errors/cancel ambiguity fail-stop with owners live
+    auto check = [&](bool ok, const char* operation) {
+        if (!ok) failstop(err.empty() ? std::string(operation) : std::string(operation) + ": " + err);
+    };
+    size_t free_before = 0, free_detached = 0, free_restored = 0, total = 0;
+    check(cudaMemGetInfo(&free_before, &total) == cudaSuccess, "entry memory query");
+    check(pf.detach_decode_cache(count, err), "prefill detach");
+    if (verifier) check(verifier->retire_cache_graphs(err), "verifier retirement");
+    check(strata::core::expert_hit_retire_graphs(dispatch, (void*) stream, err), "native hit retirement");
+    // No asynchronous reader remains. Raw borrowers and host/device maps become
+    // misses before close_checked can release offsets or the device allocation.
+    dispatch.decode_cache_ready = false;
+    dispatch.cache = nullptr; dispatch.cache_base = nullptr; dispatch.cache_slot_off = nullptr;
+    dispatch.hit_pending = false; dispatch.decided = false;
+    token_hits.cache_base = nullptr;
+    std::fill(dispatch.h_native_hit_ptr.begin(), dispatch.h_native_hit_ptr.end(), 0);
+    std::fill(dispatch.h_native_hit_meta.begin(), dispatch.h_native_hit_meta.end(), 0);
+    std::fill(host_res.begin(), host_res.end(), strata::core::kNotResident);
+    check(cudaMemcpyAsync(d_res, host_res.data(), host_res.size() * sizeof(int32_t),
+                          cudaMemcpyHostToDevice, stream) == cudaSuccess, "all-miss map submission");
+    check(cudaMemsetAsync(dispatch.native_hit_ptr, 0,
+                          dispatch.h_native_hit_ptr.size() * sizeof(unsigned long long), stream) == cudaSuccess,
+          "old native hit pointers clear");
+    check(cudaStreamSynchronize(stream) == cudaSuccess, "all-miss publication retirement");
+    check(cache.close_checked(err), "cache retirement");
+    check(state.detached(), "detached state");
+    check(cudaMemGetInfo(&free_detached, &total) == cudaSuccess, "detached memory query");
+    const double detach_ms = elapsed(started);
+    std::fprintf(stderr, "decode cache: detached arena_bytes=%lld slots=%lld wall_ms=%.3f "
+                         "free_before=%zu free_after=%zu\n",
+                 (long long) arena_bytes, (long long) slots, detach_ms, free_before, free_detached);
+    std::fflush(stderr);
+
+    // Prefill's detached gate refuses ordinary chunk execution; its layer-major
+    // implementation installs its own temporary cache before consulting slots.
+    // A healthy cancellation still restores the entire cache before returning.
+    const bool prompt_ok = pf.run(ids, count, pos, err);
+    const std::string prompt_error = err;
+    err.clear();
+    const auto restore_started = Clock::now();
+    check(cudaStreamSynchronize(stream) == cudaSuccess, "prefill completion retirement");
+    check(state.restore(), "restore state");
+    cache.set_per_layer_admission(per_layer);
+    check(sized ? cache.reopen_sized_uninitialized(slot_sizes, layers, experts, allocation_blob, err)
+                : cache.open_uninitialized(slots, layers, experts, allocation_blob, err), "fixed cache reopen");
+    check(cache.slots() == slots && cache.bytes() == arena_bytes &&
+          cache.allocation_blob_bytes() == allocation_blob, "exact allocation/blob layout restore");
+    for (int64_t i = 0; i < slots && sized; ++i)
+        check(cache.slot_offsets()[i + 1] - cache.slot_offsets()[i] == uint64_t(slot_sizes[size_t(i)]),
+              "exact slot offsets restore");
+    // Reproduce startup's deterministic padding as well as every expert blob.
+    // Initialization is inside the outer lease so no failed enqueue can free
+    // the arena before its completion is known.
+    check(cudaMemsetAsync(cache.device_slot(0), 0, size_t(arena_bytes), stream) == cudaSuccess,
+          "restored cache initialization submission");
+    check(cudaStreamSynchronize(stream) == cudaSuccess, "restored cache initialization retirement");
+    // Every source may be mmap/file-backed or resident RAM. Only this one owned
+    // host-USM slab reaches DMA, and it is immutable until the checked wait.
+    for (const Entry& e : entries) {
+        check(cache.admit(e.layer, e.expert) == e.slot, "profile order/slot assignment restore");
+        const uint8_t* bytes = source.blob(e.layer, e.expert);
+        check(bytes != nullptr, "original expert source read");
+        std::memcpy(upload.data, bytes, size_t(e.bytes));
+        check(cache.fill_slot(e.slot, static_cast<const uint8_t*>(upload.data), (void*) stream,
+                              err, int64_t(e.bytes)), "expert upload submission");
+        check(cudaStreamSynchronize(stream) == cudaSuccess, "immutable upload slab retirement");
+        // Do not use verify_slot's local pageable vector on this strict path:
+        // a failed readback must reach failstop before its destination unwinds.
+        check(cudaMemcpyAsync(readback.data, cache.device_slot(e.slot), size_t(e.bytes),
+                              cudaMemcpyDeviceToHost, stream) == cudaSuccess, "slot verification submission");
+        check(cudaStreamSynchronize(stream) == cudaSuccess, "slot verification retirement");
+        check(std::memcmp(readback.data, upload.data, size_t(e.bytes)) == 0, "restored slot byte verification");
+        check(state.filled(e.bytes), "restored slot accounting");
+    }
+    check(cudaStreamSynchronize(stream) == cudaSuccess, "restore completion retirement");
+    for (int64_t l = 0; l < layers; ++l)
+        for (int64_t e = 0; e < experts; ++e)
+            check(cache.slot_of(l, e) == saved_res[size_t(l * experts + e)], "restored residency contract");
+    check(state.publish(), "full cache publication gate");
+    const double refill_ms = elapsed(restore_started);
+    // Publish only after ALL slots and their byte checks have completed. Use the
+    // same vector storage: Prefill/dispatch retain the original host map address.
+    std::copy(saved_res.begin(), saved_res.end(), host_res.begin());
+    check(cudaMemcpyAsync(d_res, host_res.data(), host_res.size() * sizeof(int32_t),
+                          cudaMemcpyHostToDevice, stream) == cudaSuccess, "restored map submission");
+    check(cudaStreamSynchronize(stream) == cudaSuccess, "restored map publication retirement");
+    dispatch.cache = &cache; dispatch.cache_base = cache.device_slot(0);
+    dispatch.cache_slot_off = cache.slot_offsets(); dispatch.cache_blob = blob;
+    token_hits.cache_base = dispatch.cache_base; token_hits.blob = blob;
+    strata::core::VerifyHits hits;
+    hits.d_res = d_res; hits.cache_base = dispatch.cache_base; hits.blob = blob;
+    hits.slot_off = cache.slot_offsets(); hits.n_slots = slots;
+    const auto capture_started = Clock::now();
+    check(state.recapture(), "recapture state");
+    if (verifier) check(verifier->restore_cache_hits_and_recapture(hits, err), "verifier hits/recapture");
+    check(strata::core::expert_hit_prepare_graphs(dispatch, (void*) stream, err, true), "native hit recapture");
+    check(cudaStreamSynchronize(stream) == cudaSuccess, "recapture retirement");
+    const double recapture_ms = elapsed(capture_started);
+    check(pf.rebind_decode_cache(&cache, host_res.data(), err), "prefill rebind");
+    check(cudaFreeHost(upload.data) == cudaSuccess, "bounded upload slab release"); upload.data = nullptr;
+    check(cudaFreeHost(readback.data) == cudaSuccess, "bounded readback slab release"); readback.data = nullptr;
+    check(cudaMemGetInfo(&free_restored, &total) == cudaSuccess, "restored memory query");
+    check(state.complete(), "decode-ready state");
+    dispatch.decode_cache_ready = state.ready();
+    check(dispatch.decode_cache_ready && dispatch.hits_ready() && bool(dispatch.native_hit_graphs),
+          "next-decode readiness proof");
+    lease.complete = true;
+    std::fprintf(stderr, "decode cache: restored arena_bytes=%lld upload_bytes=%llu verify_bytes=%llu "
+                         "slots=%lld refill_ms=%.3f recapture_ms=%.3f restore_ms=%.3f free_after=%zu "
+                         "prompt_ok=%d decode_ready=1\n",
+                 (long long) arena_bytes, (unsigned long long) restored_bytes,
+                 (unsigned long long) restored_bytes, (long long) slots, refill_ms,
+                 recapture_ms, elapsed(restore_started), free_restored, int(prompt_ok));
+    std::fflush(stderr);
+    err = prompt_error;
+    return prompt_ok;
+}
+} // namespace strata::program::decode_cache_prefill
