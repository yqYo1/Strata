+// CPU-only contract fixture; intentionally not executed by the implementation agent.
+// Main: c++ -std=c++20 -Iinclude tests/decode_cache_prompt_state.cpp -o <outside-git>/cache-state
+#include "strata/core/decode_cache_prompt_state.hpp"
