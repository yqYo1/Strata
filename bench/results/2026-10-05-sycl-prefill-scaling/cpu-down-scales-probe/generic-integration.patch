--- a/sycl/src/kernels/cpu/iq_avx2.cpp
+++ b/sycl/src/kernels/cpu/iq_avx2.cpp
@@ -3,6 +3,9 @@
 #if defined(STRATA_IQ2S_GCC)
 #define iq256_gu_rows iq256_gu_rows_icpx
 #endif
+#if defined(STRATA_IQ4NL_SCALES)
+#define iq4nl256_down_rows iq4nl256_down_rows_icpx
+#endif
 #include "../../../../src/kernels/cpu/iq_avx2.cpp"
 
 #if defined(STRATA_IQ2S_GCC)
@@ -20,3 +23,19 @@ void iq256_gu_rows(int type, const uint8_t* blob, size_t gu_row, size_t up_off,
 }
 }  // namespace strata::kernels::cpu
 #endif
+
+#if defined(STRATA_IQ4NL_SCALES)
+#undef iq4nl256_down_rows
+namespace strata::kernels::cpu {
+void iq4nl256_down_rows_scales(const uint8_t* w, size_t row_bytes, int n,
+                              const void* const* hq, int nt, float* const* out, int r0, int r1);
+
+void iq4nl256_down_rows(const uint8_t* w, size_t row_bytes, int n,
+                        const void* const* hq, int nt, float* const* out, int r0, int r1) {
+    if (n == 640 && nt >= 2)
+        iq4nl256_down_rows_scales(w, row_bytes, n, hq, nt, out, r0, r1);
+    else
+        iq4nl256_down_rows_icpx(w, row_bytes, n, hq, nt, out, r0, r1);
+}
+}  // namespace strata::kernels::cpu
+#endif
