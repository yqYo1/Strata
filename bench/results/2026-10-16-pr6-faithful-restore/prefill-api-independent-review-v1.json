  "findings": [
    {
      "id": "H1",
      "priority": "high",
      "kind": "build_integration_defect",
      "trigger": "Build opt-in sibling harness without externally supplying a C++20 standard when compiler default is pre-C++20.",
      "sites": [
        "CMakeLists.txt:118-128",
        "sycl/CMakeLists.txt:15-17",
        "harness/prefill_api.cpp:49,94-95,176-185"
      ],
      "finding": "Only COMPILE_OPTIONS/LINK_OPTIONS are copied; child-local CMAKE_CXX_STANDARD does not set the parent-created target CXX_STANDARD and no transitive cxx_std_20 requirement exists.",
      "correction": "Declare CXX_STANDARD=20, CXX_STANDARD_REQUIRED=ON, CXX_EXTENSIONS=OFF on the new target, or equivalently publish its required compile features; inspect actual commands.",
      "executed": false
    },
    {
      "id": "H2",
      "priority": "high",
      "kind": "fixed_native_PLE_key_extent_admission_defect",
      "trigger": "Otherwise valid model/pack has matching native Q8_0 PLE key shapes [2560,256] in its index and GGUF rather than [2560,10240].",
      "sites": [
        "harness/prefill_api.cpp:254-264",
        "sycl/src/core/native_dense.cpp:187-210",
        "src/core/layout.cpp:check_one",
        "sycl/src/prefill/prefill.cpp:2762-2769",
        "sycl/src/prefill/gemm.dp.cpp:488-506"
      ],
      "finding": "NativeDense proves agreement with index and uploads the small tensor; wire_ple checks only native pointers/type. Batched PLE dequantizes fixed 10240 by 2560, exceeding that allocation. Unquantized key also lacks axis checks although its byte count is fixed.",
      "correction": "Admit key.ne0=2560, key.ne1=10240 and key.elements=2560*10240 for both native and unquantized paths before inference. Retain representation checks.",
      "executed": false
    },
    {
      "id": "H3",
      "priority": "medium",
      "kind": "fixed_PLE_table_domain_admission_defect",
      "trigger": "Supply a separate valid one-row IQ4_NL PLE-only GGUF through --ple-file while using otherwise valid full model shards/pack.",
      "sites": [
        "harness/prefill_api.cpp:282-286,407-409",
        "src/kernels/ngram.cpp:176-240,338-354",
        "include/strata/kernels/ngram.hpp:47"
      ],
      "finding": "PleTable::open validates its declared shape/payload but not fixed PLE_TABLE_ROWS; ready checks is_open. Fixed artifact hash domains then address missing rows, which read_row silently substitutes with zeros.",
      "correction": "Require table.rows()==PLE_TABLE_ROWS before wiring artifact hash constants and before inference.",
      "executed": false
    },
    {
      "id": "H4",
      "priority": "medium",
      "kind": "missing_required_small_input_gate",
      "trigger": "Main attempts the required small-input fixed-model gate before 32768-token work.",
      "sites": [
        "harness/prefill_api.cpp:141-145",
        "sycl/src/prefill/prefill.cpp:896-914",
        "prefill-api-harness-v1.md:Accepted and held cases",
        "harness/prefill_api.cpp:465-466,477-479"
      ],
      "finding": "All counts below32768 are refused and no second native small-input harness is delivered. This is an acknowledged validation gap, not an unsafe dispatch bypass.",
      "correction": "Separately review explicit validation-only small-count admission or a separate harness; keep chunk8192 and context>=8192, handle count1 PLE prev as [-1,last] instead of ids[size-2], and report first_len=min(chunk,count) for short input. Begin fresh position0 after provider gates; add continuation separately. Never skip directly to32768.",
      "executed": false
    },
    {
      "id": "H5",
      "priority": "low",
      "kind": "bounded_process_lifetime_QSA_pinned_allocation_leak",
      "trigger": "Any successful full session initialization, or partial initialization after host staging allocation.",
      "sites": [
        "harness/prefill_api.cpp:235-236",
        "sycl/src/core/session.cpp:135-140",
        "sycl/src/core/layer.cpp:683-707",
        "include/strata/core/layer.hpp:206-268"
      ],
      "finding": "session_release unregisters rope only; deleting pointer-only QsaState does not free its host_step/host_pos USM. Successful fixed session loses24 pointers totaling1392 requested bytes before process exit, plus allocator overhead.",
      "correction": "Under existing retired-owner cleanup, free each nonnull per-state host_step/host_pos before descriptor deletion, including partially initialized entries. This does not require changing historical session implementation.",
      "executed": false
    },
    {
      "id": "H6",
      "priority": "low",
      "kind": "optional_capture_close_status_ignored",
      "trigger": "Opt-in capture fwrite and fflush succeed, then fclose reports an error.",
      "sites": [
        "harness/prefill_api.cpp:470-474"
      ],
      "finding": "unique_ptr invokes fclose but discards its result, so the receipt can advertise a capture despite a close failure. This is only the declared capture error contract, not a request for fsync or crash-durability.",
      "correction": "If preserving the documented all-write-failures-are-failure contract, explicitly check the single close before receipt. No broader persistence protocol is required.",
      "executed": false
    }
  ],
