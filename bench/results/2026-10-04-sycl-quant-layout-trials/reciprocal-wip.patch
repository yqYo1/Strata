+void quantize_rounding_edges() {
+  constexpr int cols = 32, ld = 39;
+  std::vector<float> input;
+  for (int exponent : {-101, -100, -99, -30, -1, 0, 30, 100})
+    for (int code = -126; code <= 126; ++code)
+      for (int neighbor : {-1, 0, 1}) {
+        const float scale = std::ldexp(1.f, exponent);
+        const size_t row = input.size();
+        input.resize(row + ld, -777.f);
+        for (int j = 0; j < 31; ++j) {
+          float value = (float(code) + .5f) * scale;
+          if (j & 1) value = -value;
+          if (neighbor)
+            value = std::nextafter(value, neighbor > 0
+                ? std::numeric_limits<float>::infinity()
+                : -std::numeric_limits<float>::infinity());
+          input[row + j] = value;
+        }
+        input[row + 31] = 127.f * scale;
+      }
+  input.resize(input.size() + ld, 0.f);
+  const size_t rows = input.size() / ld;
+  Buffer<float> x(input.size());
+  Buffer<uint8_t> q(mmq::q8_bytes(rows, cols) + 16);
+  x.put(input);
+  std::vector<uint8_t> reference;
+  for (int mode : {0, 1, 2, 3}) {
+    setenv("STRATA_SYCL_PROMPT_QUANT_2D", std::to_string(mode).c_str(), 1);
+    q.put(std::vector<uint8_t>(q.n, 0xa5));
+    mmq::quantize(x.data(), nullptr, q.data(), 21, cols, ld, rows, &runtime->compute());
+    const auto got = q.get();
+    if (mode == 0) reference = got;
+    check(got == reference, "Q8_1 half-integer neighbors, scale fallback and row padding");
+    check(std::all_of(got.end() - 16, got.end(), [](uint8_t b) { return b == 0xa5; }),
+          "Q8_1 rounding edge guard");
+  }
+  std::cout << "Q8_1 rounding edge rows=" << rows << " all variants bitwise PASS\n";
+}
