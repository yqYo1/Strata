+int main() {
+    using strata::core::copy_engine_opt_in;
+    if (copy_engine_opt_in(nullptr) || !copy_engine_opt_in("1")) return 1;
+    for (const char* value : {"", "0", "01", "1 ", " 1", "+1", "-1", "true", "2", "1x"})
