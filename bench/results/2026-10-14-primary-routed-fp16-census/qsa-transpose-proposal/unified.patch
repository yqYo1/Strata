+                  ? int(sycl::clamp(int64_t(count) - int64_t(chunk * CHUNK),
+                                    int64_t(0), int64_t(CHUNK)))
+                  : 0;
+          const size_t slot = (kvh * chunks + chunk) * G;
+          float *pa = scratch + batch * stride;
+          float *pm = pa + partials * HD;
+          float *pl = pm + partials;
+          if (!here) {
+            if (t < G) {
+              pm[slot + t] = -INFINITY;
+              pl[slot + t] = 0;
+            }
+            for (int h = 0; h < G; ++h)
+              pa[(slot + h) * HD + t] = 0;
+            return;
+          }
+          for (int i = t; i < G * HD; i += WG)
+            sq[(i / HD) * HD + (i % 8) * 32 + (i % HD) / 8] =
+                query[(batch * s.n_head + kvh * G) * HD + i];
+          if (t < CHUNK) {
+            int64_t row = -1;
+            if (t < here) {
+              const int cell = ids[batch * cap + chunk * CHUNK + t];
+              // Bound the logical cell before page-table lookup; negative IDs
+              // and negative/nonresident pages stay masked. Ring/staging
+              // lookup uses the supplied table without remapping.
