+// Own-fork old layout1 mapping; current FP32 math and merge.
+void launch_prefill_transpose(const float *query, QsaAttnPools p, const int32_t *ids,
+            const int32_t *steps, int64_t cap, QsaShapes s,
+            QsaPrefillAttnStorage storage, float *scratch,
+            float *attn, int64_t nq, void *stream) {
+  const size_t chunks = (cap + CHUNK - 1) / CHUNK,
+               stride = qsa_decode_attn_scratch_floats(cap, s);
