+uint64_t joined_request_sequence=0; // serialized ordinary serve issuer; on-path only
+uint64_t joined_prompt_hash(const int64_t* prompt,int64_t n,int64_t max_new,int64_t context) {
+    uint64_t h=14695981039346656037ull;
+    auto word=[&](uint64_t value) { for (int b=0;b<8;++b) { h^=(value>>(8*b))&255; h*=1099511628211ull; } };
