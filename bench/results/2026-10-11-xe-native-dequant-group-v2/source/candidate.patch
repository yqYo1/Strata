+// Constant subscripts keep the captured pointer table available for scalar replacement. Whether the compiler
+// actually removes private-array traffic is an IR / component qualification question, not a source guarantee.
+// Pass the table by reference: this helper does not make another by-value array copy.
+#if defined(__clang__) || defined(__GNUC__)
+__attribute__((always_inline))
+#endif
+inline const void* dequant_group_pointer(const void* const (&p)[kIqDequantGroup], int expert) {
+    switch (expert) {
+        case 0: return p[0];
+        case 1: return p[1];
+        case 2: return p[2];
+        case 3: return p[3];
+        case 4: return p[4];
+        case 5: return p[5];
+        case 6: return p[6];
+        case 7: return p[7];
+        case 8: return p[8];
+        case 9: return p[9];
+        case 10: return p[10];
+        case 11: return p[11];
+        case 12: return p[12];
+        case 13: return p[13];
+        case 14: return p[14];
+        case 15: return p[15];
+        default: return nullptr;   // unreachable after the host slot-bounds check and the expert ND-range
+    }
+}
