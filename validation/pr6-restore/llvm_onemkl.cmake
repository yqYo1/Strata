# Independently authored validation adapter; repository LICENSE applies.
# Historical source and the default build recipe are not edited by this mode.
function(pr6_llvm_onemkl_prepare)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "PR6 LLVM/oneMKL adapter is limited to the reviewed Linux recipe")
  endif()
  # Installation dependency only: no source from the enclosing checkout is used.
  set(qualified_compiler "/home/yayoi/ghq/github.com/MistVVK/XeStrata/.worktree/fix-xestrata-e32-host-handoff-20261011/.tools/intel-llvm-v711/install/bin/clang-22")
  foreach(lang C CXX)
    file(REAL_PATH "${CMAKE_${lang}_COMPILER}" compiler_real)
    file(SHA256 "${CMAKE_${lang}_COMPILER}" compiler_hash)
    if(NOT compiler_real STREQUAL qualified_compiler OR
       NOT compiler_hash STREQUAL "1290881b4e12a5e002e5b0de0787f85328ee5fe19f253a54be1cdd97dc2f26eb")
      message(FATAL_ERROR "PR6 adapter requires the pinned IntelLLVM 22.1.0 ${lang} compiler; no compiler fallback is allowed")
    endif()
  endforeach()
  option(STRATA_NATIVE_EXPERTS "Native (IQ) expert support through ggml-cpu" ON)
  if(NOT STRATA_NATIVE_EXPERTS)
    message(FATAL_ERROR "PR6 adapter requires the complete native-expert/ggml CPU closure")
  endif()
  # Refuse an incompatible request before external backend configuration starts.
  foreach(backend BLAS CANN CUDA ET HIP METAL MUSA RPC VIRTGPU SYCL VULKAN WEBGPU ZDNN OPENCL HEXAGON ZENDNN OPENVINO)
    if(GGML_${backend})
      message(FATAL_ERROR "PR6 adapter requires GGML_${backend}=OFF")
    endif()
    set(GGML_${backend} OFF CACHE BOOL "Disabled for PR6 CPU-only ggml dependency" FORCE)
  endforeach()
  if(DEFINED GGML_CPU AND NOT GGML_CPU)
    message(FATAL_ERROR "PR6 adapter requires GGML_CPU=ON")
  endif()
  if(TARGET MKL::MKL OR TARGET MKL::MKL_SYCL)
    message(FATAL_ERROR "PR6 adapter must select oneMKL before any existing MKL targets")
  endif()
  # Match the local fork recipe, and make both CPU and SYCL threading explicit.
  # -qmkl with icpx -fsycl uses dynamic ILP64 (Intel oneMKL developer guide).
  set(MKL_ROOT "/opt/intel/oneapi/mkl/2026.1")
  set(MKL_DIR "${MKL_ROOT}/lib/cmake/mkl")
  set(MKL_LINK dynamic)
  set(MKL_SYCL_LINK dynamic)
  set(MKL_INTERFACE ilp64)
  set(MKL_INTERFACE_FULL intel_ilp64)
  set(MKL_SYCL_INTERFACE_FULL intel_ilp64)
  set(MKL_THREADING sequential)
  set(MKL_SYCL_THREADING sequential)
  set(ENABLE_OMP_OFFLOAD OFF)
  # The compiler identity above is pinned; do not add package compiler probes.
  set(ENABLE_SYCL_COMPILER ON)
  set(ENABLE_TRY_SYCL_COMPILE OFF)
  find_package(MKL 2026.1.0 EXACT CONFIG REQUIRED PATHS "${MKL_DIR}" NO_DEFAULT_PATH)
  file(REAL_PATH "${MKL_CONFIG}" actual_config)
  file(REAL_PATH "${MKL_DIR}/MKLConfig.cmake" expected_config)
  if(NOT actual_config STREQUAL expected_config OR
     NOT MKL_THREADING STREQUAL "sequential" OR NOT MKL_SYCL_THREADING STREQUAL "sequential")
    message(FATAL_ERROR "PR6 adapter requires the installed 2026.1 package with sequential CPU and SYCL MKL")
  endif()
  foreach(target MKL::MKL_SYCL::BLAS MKL::mkl_sycl_blas MKL::mkl_intel_ilp64 MKL::mkl_sequential MKL::mkl_core)
    if(NOT TARGET ${target})
      message(FATAL_ERROR "PR6 adapter is missing required installed dependency ${target}")
    endif()
  endforeach()
endfunction()

function(pr6_llvm_targets directory out)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    pr6_llvm_targets("${child}" child_targets)
    list(APPEND targets ${child_targets})
  endforeach()
  set(${out} "${targets}" PARENT_SCOPE)
endfunction()

function(pr6_llvm_onemkl_adapt)
  # These static libraries inherit the historical directory COMPILE_OPTIONS,
  # as do ggml's C and C++ targets. Editing the directory after creation is too late.
  foreach(target strata_spec strata_kernels_cpu strata_core strata_kernels strata_engine strata_prefill strata ggml ggml-base ggml-cpu)
    if(NOT TARGET ${target})
      message(FATAL_ERROR "PR6 adapter is missing expected target ${target}")
    endif()
    get_target_property(options ${target} COMPILE_OPTIONS)
    if(NOT "-fp-model=precise" IN_LIST options)
      message(FATAL_ERROR "PR6 adapter expected exact historical -fp-model=precise on ${target}")
    endif()
  endforeach()
  foreach(property COMPILE_OPTIONS INTERFACE_COMPILE_OPTIONS LINK_OPTIONS INTERFACE_LINK_OPTIONS)
    get_target_property(options strata_prefill ${property})
    if(NOT "-qmkl=sequential" IN_LIST options)
      message(FATAL_ERROR "PR6 adapter expected exact historical -qmkl=sequential in strata_prefill ${property}")
    endif()
  endforeach()
  pr6_llvm_targets("${CMAKE_CURRENT_SOURCE_DIR}/sycl" targets)
  foreach(target IN LISTS targets)
    foreach(property COMPILE_OPTIONS INTERFACE_COMPILE_OPTIONS LINK_OPTIONS INTERFACE_LINK_OPTIONS)
      get_property(has_options TARGET ${target} PROPERTY ${property} SET)
      if(NOT has_options)
        continue()
      endif()
      get_target_property(options ${target} ${property})
      set(original_options "${options}")
      if("-qmkl=sequential" IN_LIST options)
        if(NOT target STREQUAL "strata_prefill")
          message(FATAL_ERROR "Unexpected owner of historical -qmkl=sequential: ${target} ${property}")
        endif()
        list(REMOVE_ITEM options "-qmkl=sequential")
      endif()
      # Anchored replacement changes only that exact list element; generator
      # expressions, architecture/SYCL flags and unrelated options stay intact.
      if(property STREQUAL "COMPILE_OPTIONS" OR property STREQUAL "INTERFACE_COMPILE_OPTIONS")
        list(TRANSFORM options REPLACE "^-fp-model=precise$" "-ffp-model=precise")
      endif()
      if(NOT options STREQUAL original_options)
        set_property(TARGET ${target} PROPERTY ${property} "${options}")
      endif()
    endforeach()
  endforeach()
  # These targets contain only host CPU sources in the pinned closure. Override
  # inherited -fsycl late, without rewriting its list or any source ISA options.
  # PRIVATE keeps GPU consumers' compile and final SYCL link modes unchanged.
  foreach(target strata_kernels_cpu ggml ggml-base ggml-cpu)
    target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:-fno-sycl>")
  endforeach()
  # PUBLIC is essential: final executables and the sibling harness need the
  # domain's include options, SYCL device-image link flags and CPU MKL closure.
  target_link_libraries(strata_prefill PUBLIC MKL::MKL_SYCL::BLAS)
endfunction()
